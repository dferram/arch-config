[Unit]
Description=Auto-switch audio between Headphones and Speakers on jack event
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/home/ferram/.local/bin/headphone-jack-autoswitch
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
