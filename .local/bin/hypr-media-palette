#!/usr/bin/env python3
import sys
import os
import hashlib
import urllib.request
from io import BytesIO
import colorsys

def clamp(val, min_val=0, max_val=255):
    return max(min_val, min(max_val, int(val)))

def rgb_to_hex(r, g, b):
    return f"#{clamp(r):02x}{clamp(g):02x}{clamp(b):02x}"

def get_luminance(r, g, b):
    return 0.299 * r + 0.587 * g + 0.114 * b

def adjust_saturation(r, g, b, factor=1.4):
    gray = get_luminance(r, g, b)
    nr = clamp(gray + (r - gray) * factor)
    ng = clamp(gray + (g - gray) * factor)
    nb = clamp(gray + (b - gray) * factor)
    return nr, ng, nb

def boost_vibrancy(r, g, b):
    lum = get_luminance(r, g, b)
    if lum < 55:
        # Boost dark colors (like navy/dark blues/deep purples) so they glow on dark glass
        factor = 85.0 / max(8.0, lum)
        r, g, b = clamp(r * factor), clamp(g * factor), clamp(b * factor)
    elif lum > 215:
        # Tame pure white / washed out highlights
        factor = 185.0 / lum
        r, g, b = clamp(r * factor), clamp(g * factor), clamp(b * factor)
    return adjust_saturation(r, g, b, 1.45)

def shift_hue(r, g, b, delta_deg, s_mult=1.0, v_mult=1.0):
    rn, gn, bn = r / 255.0, g / 255.0, b / 255.0
    h, s, v = colorsys.rgb_to_hsv(rn, gn, bn)
    h = (h + delta_deg / 360.0) % 1.0
    s = min(1.0, max(0.25, s * s_mult))
    v = min(1.0, max(0.35, v * v_mult))
    ro, go, bo = colorsys.hsv_to_rgb(h, s, v)
    return int(ro * 255), int(go * 255), int(bo * 255)

def is_skin_tone(r, g, b):
    rn, gn, bn = r / 255.0, g / 255.0, b / 255.0
    h, s, v = colorsys.rgb_to_hsv(rn, gn, bn)
    h_deg = h * 360.0

    # True human skin tones are strictly warm orange/amber/brown (8° to 42°)
    # Pink, magenta, rose, violet (h_deg > 300° or h_deg < 8°) are NEVER human skin!
    if not (8 <= h_deg <= 42):
        return False

    # In human skin, green is always higher than or roughly equal to blue (g >= b * 0.80)
    # If blue is higher than green, it's definitely pink, purple, or magenta
    if b > g * 1.05:
        return False

    # YCbCr conversion
    cb = 128 - 0.168736 * r - 0.331264 * g + 0.5 * b
    cr = 128 + 0.5 * r - 0.418688 * g - 0.081312 * b

    # 1. Standard HSV human skin model (pale, peach, tan, brown, olive)
    hsv_skin = (8 <= h_deg <= 40) and (0.14 <= s <= 0.65) and (0.18 <= v <= 0.96) and (r > g) and (g >= b * 0.75)

    # 2. Classic YCbCr skin chrominance cluster
    ycbcr_skin = (75 <= cb <= 130) and (130 <= cr <= 180) and (r > g) and (g >= b * 0.75)

    # 3. Muddy brown / flesh shadows (coffee, mud, dark skin shadows)
    brown_shadow = (8 <= h_deg <= 42) and (0.18 <= s <= 0.60) and (v <= 0.45) and (r > g >= b)

    return hsv_skin or ycbcr_skin or brown_shadow

def extract_palette(target):
    # Default fallback: refined soft off-white accents (non-pure white)
    default_palette = ["#e2e8f0", "#cbd5e1", "#94a3b8"]

    if not target:
        return default_palette

    cache_key = hashlib.md5(target.encode("utf-8")).hexdigest()
    cache_file = f"/tmp/media_pal_{cache_key}.txt"

    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r") as f:
                lines = [line.strip() for line in f if line.strip()]
                if len(lines) >= 3:
                    return lines[:3]
        except Exception:
            pass

    try:
        from PIL import Image
        data = None
        if target.startswith("http://") or target.startswith("https://"):
            req = urllib.request.Request(target, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=3.0) as resp:
                data = resp.read()
            img = Image.open(BytesIO(data)).convert("RGB")
        elif target.startswith("file://"):
            path = target[7:]
            if not os.path.exists(path):
                return default_palette
            img = Image.open(path).convert("RGB")
        elif os.path.exists(target):
            img = Image.open(target).convert("RGB")
        else:
            return default_palette

        # Resize to 48x48 for fast, representative sampling
        small = img.resize((48, 48))
        q = small.quantize(colors=24, method=Image.Quantize.FASTOCTREE)
        palette = q.getpalette()
        color_counts = q.getcolors() or []
        total_pixels = 48 * 48

        candidates = []
        low_sat_candidates = []

        for count, idx in color_counts:
            r, g, b = palette[idx*3], palette[idx*3+1], palette[idx*3+2]
            lum = get_luminance(r, g, b)
            rn, gn, bn = r / 255.0, g / 255.0, b / 255.0
            h, s, v = colorsys.rgb_to_hsv(rn, gn, bn)

            # Exclude extreme black and pure white
            if lum < 15 or (lum > 240 and s < 0.10):
                continue

            # EXCLUDE skin and muddy flesh/brown tones
            if is_skin_tone(r, g, b):
                continue

            freq = count / total_pixels
            score = (s ** 1.3) * (1.0 + (freq ** 0.5) * 1.5)
            if lum < 35:
                score *= 0.85

            item = ((r, g, b), score, h, lum, s)
            if s >= 0.13:
                candidates.append(item)
            else:
                low_sat_candidates.append(item)

        # If no vibrant candidates found, fall back to lower saturation (grayscale/muted)
        pool = candidates if candidates else low_sat_candidates
        pool.sort(key=lambda x: x[1], reverse=True)

        selected = []
        for (rgb, sc, h, lum, s) in pool:
            # Check difference with already selected colors
            is_diff = True
            for _, _, prev_h, prev_lum, _ in selected:
                h_diff = min(abs(h - prev_h), 1.0 - abs(h - prev_h)) * 360.0
                lum_diff = abs(lum - prev_lum)
                if h_diff < 30 and lum_diff < 35:
                    is_diff = False
                    break
            if is_diff:
                selected.append((rgb, sc, h, lum, s))
            if len(selected) >= 3:
                break

        # Generate harmonious 3-color palette (Primary base, Secondary mid, Accent peak)
        final_rgb = []
        if len(selected) >= 3:
            c1 = boost_vibrancy(*selected[0][0])
            c2 = boost_vibrancy(*selected[1][0])
            c3 = boost_vibrancy(*selected[2][0])
            final_rgb = [c1, c2, c3]
        elif len(selected) == 2:
            c1 = boost_vibrancy(*selected[0][0])
            c2 = boost_vibrancy(*selected[1][0])
            c3 = boost_vibrancy(*shift_hue(*c1, 24, 1.0, 1.15))
            final_rgb = [c1, c2, c3]
        elif len(selected) == 1:
            c1 = boost_vibrancy(*selected[0][0])
            c2 = boost_vibrancy(*shift_hue(*c1, 18, 0.95, 0.95))
            c3 = boost_vibrancy(*shift_hue(*c1, -18, 1.0, 1.25))
            final_rgb = [c1, c2, c3]
        else:
            final_rgb = [(226, 232, 240), (203, 213, 225), (148, 163, 184)]

        result = [rgb_to_hex(*c) for c in final_rgb]
        try:
            with open(cache_file, "w") as f:
                f.write("\n".join(result) + "\n")
        except Exception:
            pass

        return result
    except Exception as e:
        return default_palette

if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    colors = extract_palette(arg)
    for c in colors:
        print(c)
