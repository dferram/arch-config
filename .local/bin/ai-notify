#!/usr/bin/env python3
"""Unified desktop notification helper for Claude Code, Devin CLI, Codex CLI, and Antigravity."""

import json
import os
import subprocess
import sys


def _bus_env() -> dict[str, str]:
    env = os.environ.copy()
    if not env.get("DBUS_SESSION_BUS_ADDRESS"):
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{os.getuid()}/bus"
    return env


def send_notification(app_name: str, summary: str, body: str = "", urgency: str = "normal") -> None:
    try:
        subprocess.run(
            [
                "notify-send",
                "-a", app_name,
                "-u", urgency,
                "-t", "6000",
                summary,
                body,
            ],
            env=_bus_env(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except Exception:
        pass


def _project_label(path: str | None) -> str:
    if not path:
        return ""
    name = os.path.basename(os.path.normpath(path))
    return name if name and name != "ferram" else ""


def _read_stdin_payload() -> dict:
    try:
        return json.loads(sys.stdin.read() or "{}")
    except Exception:
        return {}


def _is_devin_context(payload: dict) -> bool:
    """Detect when Devin CLI invokes an imported Claude hook."""
    if os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_ENTRYPOINT"):
        return False

    transcript_path = str(payload.get("transcript_path") or "").lower()
    if "/devin/" in transcript_path or "/.local/share/devin" in transcript_path:
        return True

    if any(k.startswith("DEVIN_") for k in os.environ) or "CHISEL_SESSION_DB" in os.environ:
        return True

    pid = os.getppid()
    seen: set[int] = set()
    while pid > 1 and pid not in seen and len(seen) < 16:
        seen.add(pid)
        try:
            with open(f"/proc/{pid}/comm", "r", encoding="utf-8", errors="ignore") as f:
                comm = f.read().strip().lower()
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmdline = f.read().replace(b"\x00", b" ").decode("utf-8", errors="ignore").lower()
            if comm in {"devin", "devin-cli"} or "/.local/share/devin/" in cmdline:
                return True
            if comm == "claude" or "/.local/share/claude/" in cmdline:
                return False
            with open(f"/proc/{pid}/stat", "r", encoding="utf-8", errors="ignore") as f:
                stat_tail = f.read().rsplit(")", 1)[1].split()
            pid = int(stat_tail[1])
        except Exception:
            break

    return False


def handle_hook_agent(app_name: str, display_name: str, event: str, payload: dict) -> None:
    if event == "stop" and payload.get("stop_hook_active"):
        return

    proj = _project_label(payload.get("cwd"))
    suffix = f" • {proj}" if proj else ""

    if event == "notification":
        title = payload.get("title") or f"{display_name}{suffix}"
        msg = payload.get("message") or "Waiting for your confirmation or response"
        send_notification(app_name, title, msg, urgency="normal")
    else:
        send_notification(app_name, f"{display_name}{suffix}", "Response ready", urgency="normal")


def handle_codex(raw_arg: str) -> None:
    try:
        payload = json.loads(raw_arg or "{}")
    except Exception:
        payload = {}

    proj = _project_label(payload.get("cwd"))
    suffix = f" • {proj}" if proj else ""
    event_type = payload.get("type", "agent-turn-complete")
    last_msg = (payload.get("last-assistant-message") or "").strip().replace("\n", " ")
    if len(last_msg) > 110:
        last_msg = last_msg[:107] + "..."

    if event_type == "approval-requested":
        send_notification("Codex", f"Codex{suffix}", last_msg or "Approval required", urgency="normal")
    else:
        send_notification("Codex", f"Codex{suffix}", last_msg or "Response ready", urgency="normal")


def main() -> None:
    if len(sys.argv) < 2:
        return
    agent = sys.argv[1].lower()
    if agent == "claude":
        event = sys.argv[2].lower() if len(sys.argv) > 2 else "stop"
        payload = _read_stdin_payload()
        if _is_devin_context(payload):
            handle_hook_agent("Devin", "Devin", event, payload)
        else:
            handle_hook_agent("Claude", "Claude Code", event, payload)
    elif agent == "devin":
        event = sys.argv[2].lower() if len(sys.argv) > 2 else "stop"
        handle_hook_agent("Devin", "Devin", event, _read_stdin_payload())
    elif agent == "codex":
        raw = sys.argv[-1] if len(sys.argv) > 2 else "{}"
        handle_codex(raw)


if __name__ == "__main__":
    main()
