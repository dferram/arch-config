#!/usr/bin/env python3
"""Unified desktop notification helper for Claude Code, Codex CLI, and Antigravity."""

import json
import os
import subprocess
import sys


def _bus_env() -> dict[str, str]:
    env = os.environ.copy()
    if not env.get("DBUS_SESSION_BUS_ADDRESS"):
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{os.getuid()}/bus"
    return env


def send_notification(app_name: str, summary: str, body: str = "", urgency: str = "normal") -> None:
    try:
        subprocess.run(
            [
                "notify-send",
                "-a", app_name,
                "-u", urgency,
                "-t", "6000",
                summary,
                body,
            ],
            env=_bus_env(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except Exception:
        pass


def _project_label(path: str | None) -> str:
    if not path:
        return ""
    name = os.path.basename(os.path.normpath(path))
    return name if name and name != "ferram" else ""


def handle_claude(event: str) -> None:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception:
        payload = {}

    if event == "stop" and payload.get("stop_hook_active"):
        return

    proj = _project_label(payload.get("cwd"))
    suffix = f" • {proj}" if proj else ""

    if event == "notification":
        title = payload.get("title") or f"Claude Code{suffix}"
        msg = payload.get("message") or "Esperando tu confirmación o respuesta"
        send_notification("Claude", title, msg, urgency="normal")
    else:
        send_notification("Claude", f"Claude Code{suffix}", "Turno completado", urgency="normal")


def handle_codex(raw_arg: str) -> None:
    try:
        payload = json.loads(raw_arg or "{}")
    except Exception:
        payload = {}

    proj = _project_label(payload.get("cwd"))
    suffix = f" • {proj}" if proj else ""
    event_type = payload.get("type", "agent-turn-complete")
    last_msg = (payload.get("last-assistant-message") or "").strip().replace("\n", " ")
    if len(last_msg) > 110:
        last_msg = last_msg[:107] + "..."

    if event_type == "approval-requested":
        send_notification("Codex", f"Codex{suffix}", last_msg or "Aprobación requerida", urgency="normal")
    else:
        send_notification("Codex", f"Codex{suffix}", last_msg or "Turno completado", urgency="normal")


def main() -> None:
    if len(sys.argv) < 2:
        return
    agent = sys.argv[1].lower()
    if agent == "claude":
        event = sys.argv[2].lower() if len(sys.argv) > 2 else "stop"
        handle_claude(event)
    elif agent == "codex":
        raw = sys.argv[-1] if len(sys.argv) > 2 else "{}"
        handle_codex(raw)


if __name__ == "__main__":
    main()
