#!/usr/bin/env python3
"""
hypr-dnd:
Manage Do Not Disturb mode for Hyprland & Quickshell.
Filters out social media and non-essential notifications while allowing
system alerts and Antigravity notifications through.
"""

import sys
import subprocess
from pathlib import Path

STATE_FILE = Path.home() / ".local" / "state" / "hypr-dnd"

def is_active():
    try:
        if STATE_FILE.exists():
            return STATE_FILE.read_text().strip().lower() == "on"
    except Exception:
        pass
    return False

def set_dnd(enabled: bool):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text("on" if enabled else "off")

    title = "Do Not Disturb: Enabled" if enabled else "Do Not Disturb: Disabled"
    msg = "System alerts and Antigravity only" if enabled else "All notifications active"
    icon = "/home/ferram/.local/share/icons/dnd-on.svg" if enabled else "/home/ferram/.local/share/icons/dnd-off.svg"

    try:
        subprocess.run([
            "notify-send", "-a", "Do Not Disturb",
            "-i", icon,
            "-t", "1500",
            "-h", "string:x-canonical-private-synchronous:dnd",
            "-h", "string:synchronous:dnd",
            "-h", f"boolean:active:{'true' if enabled else 'false'}",
            title, msg
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    return True

def main():
    arg = (sys.argv[1].lower() if len(sys.argv) > 1 else "toggle").strip()
    if arg in ["status", "-s", "--status"]:
        print("on" if is_active() else "off")
        sys.exit(0)
    elif arg in ["on", "enable", "1", "true"]:
        set_dnd(True)
    elif arg in ["off", "disable", "0", "false"]:
        set_dnd(False)
    elif arg in ["toggle", "-t"]:
        set_dnd(not is_active())
    else:
        print("Usage: hypr-dnd [status|on|off|toggle]")
        sys.exit(1)

if __name__ == "__main__":
    main()
