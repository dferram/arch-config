#!/usr/bin/env python3
import subprocess
import time
import sys
import select

CARD = "0"
CARD_NAME = "alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
HEADPHONES_PROFILE = "HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1)"
SPEAKER_PROFILE = "HiFi (HDMI1, HDMI2, HDMI3, Mic1, Speaker)"
HEADPHONES_SINK = f"{CARD_NAME.replace('alsa_card.', 'alsa_output.')}.HiFi__Headphones__sink"
SPEAKER_SINK = f"{CARD_NAME.replace('alsa_card.', 'alsa_output.')}.HiFi__Speaker__sink"

def run_cmd(args):
    try:
        subprocess.run(args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def is_headphone_plugged():
    try:
        res = subprocess.run(
            ["amixer", "-c", CARD, "cget", "iface=CARD,name='Headphone Jack'"],
            capture_output=True, text=True, check=False
        )
        for line in res.stdout.splitlines():
            line = line.strip()
            if line.startswith(": values="):
                return line == ": values=on"
    except Exception:
        pass
    return False

def switch_to_headphones():
    print("[headphone-jack-autoswitch] Headphones plugged in -> Switching to Headphones", flush=True)
    run_cmd(["amixer", "-c", CARD, "sset", "Auto-Mute Mode", "Enabled"])
    run_cmd(["pactl", "set-card-profile", CARD_NAME, HEADPHONES_PROFILE])
    time.sleep(0.2)
    run_cmd(["pactl", "set-default-sink", HEADPHONES_SINK])
    run_cmd(["amixer", "-c", CARD, "sset", "Headphone", "unmute"])
    run_cmd(["amixer", "-c", CARD, "sset", "Headphone", "100%"])
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "mute"])

def switch_to_speaker():
    print("[headphone-jack-autoswitch] Headphones unplugged -> Switching to Speakers", flush=True)
    run_cmd(["amixer", "-c", CARD, "sset", "Auto-Mute Mode", "Enabled"])
    run_cmd(["pactl", "set-card-profile", CARD_NAME, SPEAKER_PROFILE])
    time.sleep(0.2)
    run_cmd(["pactl", "set-default-sink", SPEAKER_SINK])
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "unmute"])
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "100%"])

def main():
    current_state = None

    def apply_state(plugged):
        nonlocal current_state
        if plugged:
            switch_to_headphones()
        else:
            switch_to_speaker()
        current_state = plugged

    initial_plugged = is_headphone_plugged()
    apply_state(initial_plugged)

    while True:
        proc = None
        try:
            proc = subprocess.Popen(
                ["stdbuf", "-oL", "amixer", "-c", CARD, "events"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1
            )
            while proc.poll() is None:
                r, _, _ = select.select([proc.stdout], [], [], 1.0)
                if r:
                    line = proc.stdout.readline()
                    if not line:
                        break
                    if "Headphone Jack" in line or "numid=8" in line:
                        time.sleep(0.1)
                        plugged = is_headphone_plugged()
                        if plugged != current_state:
                            apply_state(plugged)
                else:
                    plugged = is_headphone_plugged()
                    if plugged != current_state:
                        apply_state(plugged)
        except KeyboardInterrupt:
            break
        except Exception as e:
            print(f"[headphone-jack-autoswitch] Error: {e}", file=sys.stderr, flush=True)
            time.sleep(1)
        finally:
            if proc and proc.poll() is None:
                try:
                    proc.terminate()
                    proc.wait(timeout=0.5)
                except Exception:
                    pass

if __name__ == "__main__":
    main()
