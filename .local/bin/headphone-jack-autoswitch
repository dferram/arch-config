#!/usr/bin/env python3
"""
headphone-jack-autoswitch:
Monitors audio devices (3.5mm jack, Bluetooth, USB) and provides instant switching
between Headphones and Internal Speakers on Intel SOF / Realtek ALC256 Huawei hardware.
Can be run as a background service or invoked directly (e.g. via CLI or keybinding).
"""

import subprocess
import time
import sys
import os
import threading
from pathlib import Path

CARD = "0"
CARD_NAME = "alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
HEADPHONES_PROFILE = "HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1)"
SPEAKER_PROFILE = "HiFi (HDMI1, HDMI2, HDMI3, Mic1, Speaker)"
HEADPHONES_SINK = f"{CARD_NAME.replace('alsa_card.', 'alsa_output.')}.HiFi__Headphones__sink"
SPEAKER_SINK = f"{CARD_NAME.replace('alsa_card.', 'alsa_output.')}.HiFi__Speaker__sink"
SPEAKER_BOOST_SINK = "matebook_speaker_boost"

last_notify_time = 0

def get_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "WAYLAND_DISPLAY" not in env:
        runtime = Path(env["XDG_RUNTIME_DIR"])
        sockets = sorted(runtime.glob("wayland-[0-9]*"))
        if sockets:
            env["WAYLAND_DISPLAY"] = sockets[0].name
        else:
            env["WAYLAND_DISPLAY"] = "wayland-1"
    return env

def run_cmd(args):
    try:
        subprocess.run(args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=get_env())
    except Exception:
        pass

def run_cmd_async(args):
    try:
        subprocess.Popen(
            args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
            env=get_env()
        )
    except Exception:
        pass

def get_sink_metadata(target_sink):
    """Return (description, is_speaker) for a PipeWire sink name."""
    desc = target_sink
    form_factor = ""
    icon_name = ""
    try:
        out = subprocess.check_output(["pactl", "list", "sinks"], stderr=subprocess.DEVNULL).decode()
        in_block = False
        for line in out.splitlines():
            stripped = line.strip()
            if stripped.startswith("Name:"):
                in_block = (stripped.split(":", 1)[1].strip() == target_sink)
            elif in_block:
                if stripped.startswith("Description:"):
                    desc = stripped.split(":", 1)[1].strip()
                elif stripped.startswith("device.form_factor ="):
                    form_factor = stripped.split("=", 1)[1].strip().strip('"').lower()
                elif stripped.startswith("device.icon_name ="):
                    icon_name = stripped.split("=", 1)[1].strip().strip('"').lower()
    except Exception:
        pass
    lower_desc = desc.lower()
    is_bt_speaker = (
        form_factor == "speaker"
        or "speaker" in icon_name
        or any(k in lower_desc for k in ("echo", "dot", "show", "alexa", "speaker", "soundbar", "jbl", "bose", "sonos"))
    )
    return desc, is_bt_speaker


def notify_bluetooth_connected(desc, is_speaker, vol_str):
    global last_notify_time
    now = time.time()
    if now - last_notify_time < 1.0:
        return
    last_notify_time = now

    if is_speaker:
        title = "Bluetooth Speaker Connected"
        icon = "audio-speakers-bluetooth"
    else:
        title = "Bluetooth Headphones Connected"
        icon_path = "/home/ferram/.local/share/icons/headphones.svg"
        icon = f"file://{icon_path}" if os.path.exists(icon_path) else "audio-headphones-bluetooth"

    run_cmd([
        "notify-send", "-a", "Bluetooth",
        "-i", icon,
        "-t", "2500",
        "-h", "string:x-canonical-private-synchronous:audio_output",
        "-h", "string:synchronous:audio_output",
        title,
        f"Audio routed to {desc} • Volume {vol_str}"
    ])


def notify_headphones_connected(vol_str="35%"):
    global last_notify_time
    now = time.time()
    if now - last_notify_time < 1.0:
        return
    last_notify_time = now

    icon_path = "/home/ferram/.local/share/icons/headphones.svg"
    icon = f"file://{icon_path}" if os.path.exists(icon_path) else "audio-headphones-symbolic"

    run_cmd([
        "notify-send", "-a", "Headphones",
        "-i", icon,
        "-t", "2500",
        "-h", "string:x-canonical-private-synchronous:audio_output",
        "-h", "string:synchronous:audio_output",
        "Headphones Connected",
        f"Audio routed to Headphones • Volume {vol_str}"
    ])

def notify_speaker_activated():
    global last_notify_time
    now = time.time()
    if now - last_notify_time < 1.0:
        return
    last_notify_time = now

    run_cmd([
        "notify-send", "-a", "Speakers",
        "-i", "audio-speakers-symbolic",
        "-t", "2500",
        "-h", "string:x-canonical-private-synchronous:audio_output",
        "-h", "string:synchronous:audio_output",
        "Speakers Activated",
        "Audio routed to laptop speakers"
    ])

def is_headphone_plugged():
    try:
        res = subprocess.run(
            ["amixer", "-c", CARD, "cget", "iface=CARD,name='Headphone Jack'"],
            capture_output=True, text=True, check=False
        )
        for line in res.stdout.splitlines():
            line = line.strip()
            if line.startswith(": values="):
                return line == ": values=on"
    except Exception:
        pass
    return False

def get_current_profile():
    try:
        out = subprocess.check_output(["pactl", "list", "cards"], stderr=subprocess.DEVNULL).decode()
        for line in out.splitlines():
            if "Active Profile:" in line:
                return line.split(":", 1)[1].strip()
    except Exception:
        pass
    return ""

def switch_to_headphones(notify=True):
    print("[headphone-jack-autoswitch] Switching to Headphones", flush=True)
    # Ensure Auto-Mute is Disabled so ALSA doesn't mute headphones
    run_cmd(["amixer", "-c", CARD, "sset", "Auto-Mute Mode", "Disabled"])
    run_cmd(["pactl", "set-card-profile", CARD_NAME, HEADPHONES_PROFILE])
    time.sleep(0.15)
    run_cmd(["pactl", "set-default-sink", HEADPHONES_SINK])
    move_direct_alsa_streams_to(HEADPHONES_SINK)
    run_cmd(["amixer", "-c", CARD, "sset", "Headphone", "unmute"])
    run_cmd(["amixer", "-c", CARD, "sset", "Headphone", "80%"])
    run_cmd(["amixer", "-c", CARD, "sset", "Master", "unmute"])
    run_cmd(["amixer", "-c", CARD, "sset", "Master", "100%"])
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "mute"])

    if notify:
        time.sleep(0.15)
        run_cmd(["/home/ferram/.local/bin/hypr-volume", "set", "35"])
        notify_headphones_connected("35%")

def is_external_sink_name(sname):
    lower = sname.lower()
    return "bluez" in lower or ("usb" in lower and "speaker" not in lower)


def sink_exists(target_sink):
    try:
        out = subprocess.check_output(["pactl", "list", "sinks", "short"], stderr=subprocess.DEVNULL).decode()
        for line in out.strip().splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] == target_sink:
                return True
    except Exception:
        pass
    return False


def move_direct_alsa_streams_to(target_sink):
    """Move app playback streams from internal ALSA/speaker-boost sinks onto target_sink."""
    try:
        sinks_out = subprocess.check_output(["pactl", "list", "sinks", "short"], stderr=subprocess.DEVNULL).decode()
        internal_ids = set()
        for line in sinks_out.strip().splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] != target_sink:
                if parts[1].startswith("alsa_output.") or parts[1] == SPEAKER_BOOST_SINK:
                    internal_ids.add(parts[0])
        if not internal_ids:
            return

        inputs_out = subprocess.check_output(["pactl", "list", "sink-inputs"], stderr=subprocess.DEVNULL).decode()
        cur_id = None
        cur_sink = None
        cur_node = ""
        for raw in inputs_out.splitlines() + ["Sink Input #END"]:
            line = raw.strip()
            if line.startswith("Sink Input #"):
                if cur_id and cur_sink in internal_ids and cur_node != "matebook_speaker_boost_output":
                    run_cmd(["pactl", "move-sink-input", cur_id, target_sink])
                cur_id = line.split("#", 1)[1].strip()
                if cur_id == "END":
                    cur_id = None
                cur_sink = None
                cur_node = ""
            elif line.startswith("Sink:"):
                cur_sink = line.split(":", 1)[1].strip()
            elif line.startswith("node.name ="):
                cur_node = line.split("=", 1)[1].strip().strip('"')
    except Exception:
        pass


def get_external_headphone_sink():
    try:
        out = subprocess.check_output(["pactl", "list", "sinks", "short"], stderr=subprocess.DEVNULL).decode()
        for sline in out.strip().split("\n"):
            parts = sline.split()
            if len(parts) >= 2:
                sname = parts[1]
                if is_external_sink_name(sname):
                    return sname
    except Exception:
        pass
    return None

def switch_to_speaker(notify=True):
    ext = get_external_headphone_sink()
    if ext:
        print(f"[headphone-jack-autoswitch] External {ext} active -> Keeping {ext}", flush=True)
        run_cmd(["pactl", "set-default-sink", ext])
        return

    print("[headphone-jack-autoswitch] Switching to Speakers", flush=True)
    run_cmd(["amixer", "-c", CARD, "sset", "Auto-Mute Mode", "Disabled"])
    run_cmd(["pactl", "set-card-profile", CARD_NAME, SPEAKER_PROFILE])
    time.sleep(0.15)
    # Keep underlying ALSA speaker sink fixed at 100% (0.00 dB) unmuted
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "unmute"])
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "100%"])
    run_cmd(["amixer", "-c", CARD, "sset", "Master", "unmute"])
    run_cmd(["amixer", "-c", CARD, "sset", "Master", "100%"])
    run_cmd(["pactl", "set-sink-mute", SPEAKER_SINK, "0"])
    run_cmd(["pactl", "set-sink-volume", SPEAKER_SINK, "65536"])

    target = SPEAKER_BOOST_SINK if sink_exists(SPEAKER_BOOST_SINK) else SPEAKER_SINK
    run_cmd(["pactl", "set-default-sink", target])
    move_direct_alsa_streams_to(target)

    # Enable hardware DRC for laptop speaker protection
    run_cmd(["amixer", "-c", CARD, "sset", "Post Mixer Analog Playback DRC switch", "on"])
    if notify:
        notify_speaker_activated()

def toggle():
    prof = get_current_profile()
    if "Headphones" in prof:
        switch_to_speaker()
    else:
        switch_to_headphones()

def monitor_bluetooth_and_usb():
    """Listens for new Bluetooth or external USB headphone connections and enforces safe 40% volume."""
    known_external_sinks = set()
    while True:
        proc = None
        try:
            proc = subprocess.Popen(
                ["pactl", "subscribe"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
                env=get_env()
            )
            for raw_line in proc.stdout:
                line = raw_line.strip().lower()
                if "sink" in line or "server" in line:
                    try:
                        out = subprocess.check_output(["pactl", "list", "sinks", "short"], stderr=subprocess.DEVNULL).decode()
                        active_sinks = set()
                        for sline in out.strip().split("\n"):
                            parts = sline.split()
                            if len(parts) >= 2:
                                sname = parts[1]
                                is_external_hp = is_external_sink_name(sname)
                                if is_external_hp:
                                    active_sinks.add(sname)
                                    if sname not in known_external_sinks:
                                        known_external_sinks.add(sname)
                                        is_bt = "bluez" in sname.lower()
                                        desc, is_bt_speaker = get_sink_metadata(sname) if is_bt else (sname, False)
                                        target_vol = "60" if is_bt_speaker else "40"
                                        print(f"[headphone-jack-autoswitch] Detected new external sink: {sname} ({desc}) -> Routing sound and setting volume to {target_vol}%", flush=True)
                                        run_cmd(["pactl", "set-default-sink", sname])
                                        move_direct_alsa_streams_to(sname)
                                        time.sleep(0.25)
                                        run_cmd(["/home/ferram/.local/bin/hypr-volume", "set", target_vol])
                                        if is_bt:
                                            notify_bluetooth_connected(desc, is_bt_speaker, f"{target_vol}%")
                                        else:
                                            notify_headphones_connected(f"{target_vol}%")
                        known_external_sinks.intersection_update(active_sinks)
                    except Exception:
                        pass
        except Exception as e:
            print(f"[headphone-jack-autoswitch] Bluetooth/USB monitor error: {e}", file=sys.stderr, flush=True)
            time.sleep(2)
        finally:
            if proc and proc.poll() is None:
                try:
                    proc.terminate()
                    proc.wait(timeout=0.5)
                except Exception:
                    pass

def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower().strip()
        if cmd in ["hp", "headphones", "headphone"]:
            switch_to_headphones()
            return
        elif cmd in ["spk", "speaker", "speakers"]:
            switch_to_speaker()
            return
        elif cmd in ["toggle", "switch", "t"]:
            toggle()
            return
        elif cmd in ["status", "current"]:
            prof = get_current_profile()
            print("Headphones" if "Headphones" in prof else "Speaker")
            return
        else:
            print("Usage: headphone-jack-autoswitch [headphones | speaker | toggle | status]")
            return

    # Daemon mode: Start Bluetooth/USB monitor thread
    bt_thread = threading.Thread(target=monitor_bluetooth_and_usb, daemon=True)
    bt_thread.start()

    # In daemon mode: If ALSA jack detection transitions to ON, auto switch.
    current_plugged = is_headphone_plugged()

    # Ensure Auto-Mute is disabled and route correctly on startup
    run_cmd(["amixer", "-c", CARD, "sset", "Auto-Mute Mode", "Disabled"])
    if not get_external_headphone_sink():
        if current_plugged:
            switch_to_headphones(notify=False)
        else:
            for _ in range(10):
                if sink_exists(SPEAKER_BOOST_SINK):
                    break
                time.sleep(0.2)
            switch_to_speaker(notify=False)

    def alsa_events_listener():
        nonlocal current_plugged
        while True:
            proc = None
            try:
                proc = subprocess.Popen(
                    ["amixer", "-c", CARD, "events"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    bufsize=1,
                    env=get_env()
                )
                for line in iter(proc.stdout.readline, ''):
                    if "Headphone Jack" in line or "numid=8" in line:
                        time.sleep(0.05)
                        plugged = is_headphone_plugged()
                        if plugged != current_plugged:
                            current_plugged = plugged
                            if plugged:
                                switch_to_headphones()
                            else:
                                switch_to_speaker()
            except Exception:
                time.sleep(1)
            finally:
                if proc and proc.poll() is None:
                    try:
                        proc.terminate()
                        proc.wait(timeout=0.5)
                    except Exception:
                        pass
                time.sleep(0.5)

    events_thread = threading.Thread(target=alsa_events_listener, daemon=True)
    events_thread.start()

    while True:
        try:
            time.sleep(2.0)
            plugged = is_headphone_plugged()
            if plugged != current_plugged:
                current_plugged = plugged
                if plugged:
                    switch_to_headphones()
                else:
                    switch_to_speaker()
        except KeyboardInterrupt:
            break
        except Exception:
            time.sleep(2.0)

if __name__ == "__main__":
    main()
