#!/usr/bin/env python3
"""
headphone-jack-autoswitch:
Monitors hardware 3.5mm headphone jack events and Bluetooth/USB audio connections.
Automatically switches audio routing between Headphones and Speakers, and enforces
a safe 40% volume level whenever headphones are connected to protect human hearing.
"""

import subprocess
import time
import sys
import select
import threading

CARD = "0"
CARD_NAME = "alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
HEADPHONES_PROFILE = "HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1)"
SPEAKER_PROFILE = "HiFi (HDMI1, HDMI2, HDMI3, Mic1, Speaker)"
HEADPHONES_SINK = f"{CARD_NAME.replace('alsa_card.', 'alsa_output.')}.HiFi__Headphones__sink"
SPEAKER_SINK = f"{CARD_NAME.replace('alsa_card.', 'alsa_output.')}.HiFi__Speaker__sink"

last_notify_time = 0

def run_cmd(args):
    try:
        subprocess.run(args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def notify_headphones_connected():
    global last_notify_time
    now = time.time()
    if now - last_notify_time < 3.0:
        return
    last_notify_time = now

    run_cmd([
        "notify-send", "-a", "Hearing Protection",
        "-i", "file:///home/ferram/.local/share/icons/headphones.svg",
        "-t", "2500",
        "-h", "string:x-canonical-private-synchronous:headphones_connected",
        "-h", "string:synchronous:headphones_connected",
        "Headphones Connected",
        "Volume set to 40%"
    ])

def is_headphone_plugged():
    try:
        res = subprocess.run(
            ["amixer", "-c", CARD, "cget", "iface=CARD,name='Headphone Jack'"],
            capture_output=True, text=True, check=False
        )
        for line in res.stdout.splitlines():
            line = line.strip()
            if line.startswith(": values="):
                return line == ": values=on"
    except Exception:
        pass
    return False

def switch_to_headphones():
    print("[headphone-jack-autoswitch] Headphones plugged in -> Switching to Headphones", flush=True)
    run_cmd(["amixer", "-c", CARD, "sset", "Auto-Mute Mode", "Enabled"])
    run_cmd(["pactl", "set-card-profile", CARD_NAME, HEADPHONES_PROFILE])
    time.sleep(0.2)
    run_cmd(["pactl", "set-default-sink", HEADPHONES_SINK])
    run_cmd(["amixer", "-c", CARD, "sset", "Headphone", "unmute"])
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "mute"])

    # Automatically set volume to 40% (safe level to protect ears)
    time.sleep(0.15)
    run_cmd(["/home/ferram/.local/bin/hypr-volume", "set", "40"])
    notify_headphones_connected()

def switch_to_speaker():
    print("[headphone-jack-autoswitch] Headphones unplugged -> Switching to Speakers", flush=True)
    run_cmd(["amixer", "-c", CARD, "sset", "Auto-Mute Mode", "Enabled"])
    run_cmd(["pactl", "set-card-profile", CARD_NAME, SPEAKER_PROFILE])
    time.sleep(0.2)
    run_cmd(["pactl", "set-default-sink", SPEAKER_SINK])
    run_cmd(["amixer", "-c", CARD, "sset", "Speaker", "unmute"])

def monitor_bluetooth_and_usb():
    """Listens for new Bluetooth or external USB headphone connections and enforces safe 40% volume."""
    known_external_sinks = set()
    while True:
        proc = None
        try:
            proc = subprocess.Popen(
                ["pactl", "subscribe"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1
            )
            for raw_line in proc.stdout:
                line = raw_line.strip().lower()
                if "sink" in line or "server" in line:
                    try:
                        out = subprocess.check_output(["pactl", "list", "sinks", "short"], stderr=subprocess.DEVNULL).decode()
                        active_sinks = set()
                        for sline in out.strip().split("\n"):
                            parts = sline.split()
                            if len(parts) >= 2:
                                sname = parts[1]
                                # Only match external Bluetooth or USB devices (internal PCI 3.5mm jack is handled by switch_to_headphones)
                                is_external_hp = ("bluez" in sname.lower() or "usb" in sname.lower()) and ("speaker" not in sname.lower())
                                if is_external_hp:
                                    active_sinks.add(sname)
                                    if sname not in known_external_sinks:
                                        known_external_sinks.add(sname)
                                        print(f"[headphone-jack-autoswitch] Detected new external headphone sink: {sname} -> Setting volume to 40%", flush=True)
                                        time.sleep(0.25)
                                        run_cmd(["/home/ferram/.local/bin/hypr-volume", "set", "40"])
                                        notify_headphones_connected()
                        # Prune disconnected devices
                        known_external_sinks.intersection_update(active_sinks)
                    except Exception:
                        pass
        except Exception as e:
            print(f"[headphone-jack-autoswitch] Bluetooth/USB monitor error: {e}", file=sys.stderr, flush=True)
            time.sleep(2)
        finally:
            if proc and proc.poll() is None:
                try:
                    proc.terminate()
                    proc.wait(timeout=0.5)
                except Exception:
                    pass

def main():
    # Start Bluetooth/USB monitor thread
    bt_thread = threading.Thread(target=monitor_bluetooth_and_usb, daemon=True)
    bt_thread.start()

    current_state = None

    def apply_state(plugged):
        nonlocal current_state
        if plugged:
            switch_to_headphones()
        else:
            switch_to_speaker()
        current_state = plugged

    initial_plugged = is_headphone_plugged()
    apply_state(initial_plugged)

    while True:
        proc = None
        try:
            proc = subprocess.Popen(
                ["stdbuf", "-oL", "amixer", "-c", CARD, "events"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1
            )
            while proc.poll() is None:
                r, _, _ = select.select([proc.stdout], [], [], 1.0)
                if r:
                    line = proc.stdout.readline()
                    if not line:
                        break
                    if "Headphone Jack" in line or "numid=8" in line:
                        time.sleep(0.1)
                        plugged = is_headphone_plugged()
                        if plugged != current_state:
                            apply_state(plugged)
                else:
                    plugged = is_headphone_plugged()
                    if plugged != current_state:
                        apply_state(plugged)
        except KeyboardInterrupt:
            break
        except Exception as e:
            print(f"[headphone-jack-autoswitch] Error: {e}", file=sys.stderr, flush=True)
            time.sleep(1)
        finally:
            if proc and proc.poll() is None:
                try:
                    proc.terminate()
                    proc.wait(timeout=0.5)
                except Exception:
                    pass

if __name__ == "__main__":
    main()
