#!/usr/bin/env python3
"""
hypr-reminders:
Backend and background notification daemon for calendar events and reminders.
Supports adding, listing, toggling, deleting reminders, and 5-min-before desktop alerts.
"""

import sys
import os
import re
import json
import time
import fcntl
import calendar
import argparse
import subprocess
from difflib import SequenceMatcher
from datetime import datetime, date, timedelta, timezone
from pathlib import Path

DATA_DIR = Path.home() / ".local" / "share" / "hypr-reminders"
DATA_FILE = DATA_DIR / "reminders.json"
CATEGORIES_FILE = DATA_DIR / "categories.json"
TIMERS_FILE = DATA_DIR / "timers.json"
GCAL_TOKEN_FILE = DATA_DIR / "gcal_token.json"
GCAL_CREDS_FILE = DATA_DIR / "gcal_credentials.json"
GCAL_TV_CREDS_FILE = DATA_DIR / "gcal_tv_credentials.json"
GCAL_SYNC_STATE_FILE = DATA_DIR / "gcal_sync_state.json"
SYNC_LOCK_FILE = DATA_DIR / ".sync.lock"
BACKUP_PRE_MERGE_FILE = DATA_DIR / "reminders.json.pre-gcal-backup"

DAY_CODES = ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]
VALID_REPEATS = {"none", "daily", "weekdays", "weekly", "biweekly", "monthly", "yearly"}

DEFAULT_CATEGORIES = {
    "Personal": {"color": "#f97316", "icon": "user"},
    "Sara": {"color": "#ff2d55", "icon": "heart"},
    "Marvel": {"color": "#10b981", "icon": "marvel"},
    "Colgate-Palmolive": {"color": "#0067fe", "icon": "briefcase"},
    "Projects": {"color": "#14b8a6", "icon": "code"},
    "Free Lance": {"color": "#06b6d4", "icon": "code"},
    "School": {"color": "#a855f7", "icon": "book"},
    "F1": {"color": "#E10600", "icon": "f1"},
    "Workshops": {"color": "#8b5cf6", "icon": "presentation"},
    "Community": {"color": "#f59e0b", "icon": "users"}
}

def ensure_data():
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    if not DATA_FILE.exists():
        DATA_FILE.write_text("[]", encoding="utf-8")

def load_categories():
    ensure_data()
    cats = dict(DEFAULT_CATEGORIES)
    if CATEGORIES_FILE.exists():
        try:
            custom = json.loads(CATEGORIES_FILE.read_text(encoding="utf-8"))
            if isinstance(custom, dict):
                cats.update(custom)
            elif isinstance(custom, list):
                for c in custom:
                    if isinstance(c, str) and c:
                        cats[c] = {"color": "#38bdf8", "icon": "tag"}
        except Exception:
            pass
    reminders = load_reminders()
    for r in reminders:
        c = r.get("category")
        if c and c not in cats:
            cats[c] = {"color": "#38bdf8", "icon": "tag"}
    return cats

def add_category(name, color="#38bdf8", icon="tag"):
    ensure_data()
    name = name.strip()
    if not name:
        return load_categories()
    custom = {}
    if CATEGORIES_FILE.exists():
        try:
            custom = json.loads(CATEGORIES_FILE.read_text(encoding="utf-8"))
            if not isinstance(custom, dict):
                custom = {}
        except Exception:
            custom = {}
    custom[name] = {"color": color, "icon": icon}
    CATEGORIES_FILE.write_text(json.dumps(custom, indent=2, ensure_ascii=False), encoding="utf-8")
    return load_categories()

def load_reminders():
    ensure_data()
    try:
        data = json.loads(DATA_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, list) else []
    except Exception:
        return []

def save_reminders(reminders):
    ensure_data()
    temp_file = DATA_FILE.with_suffix(".tmp")
    temp_file.write_text(json.dumps(reminders, indent=2, ensure_ascii=False), encoding="utf-8")
    temp_file.replace(DATA_FILE)

def normalize_repeat(rep):
    val = (rep or "none").strip().lower()
    return val if val in VALID_REPEATS else "none"


def normalize_repeat_days(days):
    if not days:
        return []
    if isinstance(days, str):
        days = [d.strip().upper() for d in days.split(",") if d.strip()]
    out = []
    for d in days:
        code = str(d).strip().upper()[:2]
        if code in DAY_CODES and code not in out:
            out.append(code)
    return out


def normalize_repeat_until(until_str):
    if not until_str:
        return ""
    s = str(until_str).strip()
    try:
        datetime.strptime(s, "%Y-%m-%d")
        return s
    except ValueError:
        return ""


def occurs_on(rem, target_date: date) -> bool:
    d_str = rem.get("date", "")
    try:
        start_date = datetime.strptime(d_str, "%Y-%m-%d").date()
    except ValueError:
        return False

    if target_date < start_date:
        return False

    until_str = rem.get("repeat_until") or ""
    if until_str:
        try:
            until_date = datetime.strptime(until_str, "%Y-%m-%d").date()
            if target_date > until_date:
                return False
        except ValueError:
            pass

    exdates = rem.get("exdates") or []
    if target_date.strftime("%Y-%m-%d") in exdates:
        return False

    rep = normalize_repeat(rem.get("repeat"))
    if rep == "none":
        return target_date == start_date
    if rep == "daily":
        return True
    if rep == "weekdays":
        return target_date.weekday() < 5
    if rep == "weekly":
        rep_days = normalize_repeat_days(rem.get("repeat_days"))
        if rep_days:
            return DAY_CODES[target_date.weekday()] in rep_days
        return (target_date - start_date).days % 7 == 0
    if rep == "biweekly":
        return (target_date - start_date).days % 14 == 0
    if rep == "monthly":
        max_day = calendar.monthrange(target_date.year, target_date.month)[1]
        return target_date.day == min(start_date.day, max_day)
    if rep == "yearly":
        if target_date.month != start_date.month:
            return False
        max_day = calendar.monthrange(target_date.year, target_date.month)[1]
        return target_date.day == min(start_date.day, max_day)
    return target_date == start_date


def utc_now_iso():
    return datetime.now(timezone.utc).isoformat()


def spawn_background_sync():
    try:
        if not GCAL_TOKEN_FILE.exists():
            return
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "sync"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass


def add_reminder(title, date_str, time_str, category="Colgate-Palmolive", notes="", photo="", repeat="none", logo="", repeat_days=None, repeat_until="", sync_bg=True):
    reminders = load_reminders()

    # Validate date
    try:
        datetime.strptime(date_str, "%Y-%m-%d")
    except ValueError:
        date_str = datetime.now().strftime("%Y-%m-%d")

    # Validate time
    try:
        datetime.strptime(time_str, "%H:%M")
    except ValueError:
        time_str = "12:00"

    rem_id = f"rem_{int(time.time())}_{len(reminders) + 1}"
    cat = category.strip() if (category and category.strip()) else "Personal"
    rep = normalize_repeat(repeat)
    rep_days = normalize_repeat_days(repeat_days) if rep == "weekly" else []
    rep_until = normalize_repeat_until(repeat_until) if rep != "none" else ""

    item = {
        "id": rem_id,
        "title": title.strip(),
        "date": date_str,
        "time": time_str,
        "category": cat,
        "notes": notes.strip(),
        "photo": photo.strip() if photo else "",
        "repeat": rep,
        "logo": (logo or "").strip().lower(),
        "done": False,
        "created_at": datetime.now().isoformat(),
        "local_updated": utc_now_iso(),
        "notified_5min": False,
        "notified_due": False
    }
    if rep_days:
        item["repeat_days"] = rep_days
    if rep_until:
        item["repeat_until"] = rep_until

    reminders.append(item)
    reminders.sort(key=lambda x: (x.get("date", ""), x.get("time", "")))
    save_reminders(reminders)
    if sync_bg:
        spawn_background_sync()
    return item


def edit_reminder(rem_id, title=None, date_str=None, time_str=None, category=None, notes=None, photo=None, repeat=None, logo=None, repeat_days=None, repeat_until=None, sync_bg=True):
    reminders = load_reminders()
    for r in reminders:
        if r.get("id") == rem_id:
            if title is not None and title.strip():
                r["title"] = title.strip()
            if date_str is not None and date_str.strip():
                r["date"] = date_str.strip()
            if time_str is not None and time_str.strip():
                r["time"] = time_str.strip()
                r["all_day"] = False
            if category is not None and category.strip():
                r["category"] = category.strip()
            if notes is not None:
                r["notes"] = notes.strip()
            if photo is not None:
                r["photo"] = photo.strip()
            if repeat is not None:
                new_rep = normalize_repeat(repeat)
                r["repeat"] = new_rep
                if new_rep != "weekly":
                    r.pop("repeat_days", None)
                if new_rep == "none":
                    r.pop("repeat_until", None)
                    r.pop("gcal_rrule", None)
            if repeat_days is not None:
                days_norm = normalize_repeat_days(repeat_days)
                if days_norm and r.get("repeat") == "weekly":
                    r["repeat_days"] = days_norm
                else:
                    r.pop("repeat_days", None)
            if repeat_until is not None:
                until_norm = normalize_repeat_until(repeat_until)
                if until_norm and r.get("repeat") != "none":
                    r["repeat_until"] = until_norm
                else:
                    r.pop("repeat_until", None)
            r["local_updated"] = utc_now_iso()
            if logo is not None:
                r["logo"] = logo.strip().lower()
            r["notified_5min"] = False
            r["notified_due"] = False
            r.pop("last_notified_5min_date", None)
            r.pop("last_notified_due_date", None)
            reminders.sort(key=lambda x: (x.get("date", ""), x.get("time", "")))
            save_reminders(reminders)
            if sync_bg:
                spawn_background_sync()
            return r
    return None


def queue_gcal_delete(gcal_id):
    if not gcal_id:
        return
    state = load_sync_state()
    pending = state.get("pending_deletes", [])
    if gcal_id not in pending:
        pending.append(gcal_id)
    state["pending_deletes"] = pending
    save_sync_state(state)


def delete_reminder(rem_id, sync_bg=True):
    reminders = load_reminders()
    deleted_item = next((r for r in reminders if r.get("id") == rem_id), None)
    new_rems = [r for r in reminders if r.get("id") != rem_id]
    if len(new_rems) != len(reminders):
        save_reminders(new_rems)
        if deleted_item and deleted_item.get("gcal_id"):
            queue_gcal_delete(deleted_item["gcal_id"])
            if sync_bg:
                spawn_background_sync()
        return True
    return False

def toggle_done(rem_id):
    reminders = load_reminders()
    for r in reminders:
        if r.get("id") == rem_id:
            r["done"] = not r.get("done", False)
            save_reminders(reminders)
            return r
    return None

