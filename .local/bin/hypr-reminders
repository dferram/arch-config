def play_sound(sound_name="message"):
    for ext in [".oga", ".wav", ".ogg", ".mp3"]:
        custom_sound = Path.home() / ".local" / "share" / "sounds" / f"{sound_name}{ext}"
        if custom_sound.exists():
            try:
                subprocess.Popen(["pw-play", str(custom_sound)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except Exception:
                pass
    sound_path = Path("/usr/share/sounds/freedesktop/stereo") / f"{sound_name}.oga"
    if sound_path.exists():
        try:
            subprocess.Popen(["pw-play", str(sound_path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def load_timers():
    ensure_data()
    if not TIMERS_FILE.exists():
        return []
    try:
        data = json.loads(TIMERS_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, (list, dict)) else []
    except Exception:
        return []


def save_timers(timers):
    ensure_data()
    temp_file = TIMERS_FILE.with_suffix(".tmp")
    temp_file.write_text(json.dumps(timers, indent=2, ensure_ascii=False), encoding="utf-8")
    temp_file.replace(TIMERS_FILE)


def check_and_notify(reminders=None):
    if reminders is None:
        reminders = load_reminders()
    
    now = datetime.now()
    today_date = now.date()
    yesterday_date = today_date - timedelta(days=1)
    changed = False

    for rem in reminders:
        if rem.get("done", False):
            continue

        t_str = rem.get("time", "")
        rep = normalize_repeat(rem.get("repeat"))

        # Determine occurrence date to evaluate (today, or yesterday for midnight catch-up)
        occ_date = None
        if rep == "none":
            d_str = rem.get("date", "")
            try:
                occ_date = datetime.strptime(d_str, "%Y-%m-%d").date()
            except Exception:
                continue
        else:
            if occurs_on(rem, today_date):
                occ_date = today_date
            elif occurs_on(rem, yesterday_date):
                occ_date = yesterday_date
            else:
                continue

        occ_str = occ_date.strftime("%Y-%m-%d")
        try:
            event_dt = datetime.strptime(f"{occ_str} {t_str}", "%Y-%m-%d %H:%M")
        except Exception:
            continue

        diff_seconds = (event_dt - now).total_seconds()
        already_5min = rem.get("notified_5min", False) if rep == "none" else (rem.get("last_notified_5min_date") == occ_str)
        already_due = rem.get("notified_due", False) if rep == "none" else (rem.get("last_notified_due_date") == occ_str)

        title_low = (rem.get("title", "") + " " + rem.get("notes", "")).lower()
        cat_low = (rem.get("category", "")).lower().strip()
        logo_low = (rem.get("logo", "")).lower().strip()
        is_f1 = (cat_low == "f1") or ("f1" in title_low) or ("formula 1" in title_low) or ("grand prix" in title_low)
        is_sara = (cat_low == "sara") or ("sara" in title_low)
        is_marvel = (cat_low == "marvel") or ("doomsday" in title_low) or ("marvel" in title_low)
        is_cp = cat_low in ("colgate-palmolive", "colgate") or ("colgate" in title_low)
        is_school = cat_low in ("school", "troyanos") or ("troyanos" in title_low)
        is_community = (cat_low == "community") or ("figma" in title_low) or ("meetup" in title_low)
        if is_f1:
            icon_to_use = ICON_F1
        elif is_sara:
            icon_to_use = ICON_HEART
        elif is_marvel:
            icon_to_use = ICON_MARVEL
        elif is_cp:
            icon_to_use = ICON_CP
        elif is_school:
            icon_to_use = ICON_TROYANOS
        elif is_community:
            if logo_low == "fof-qro" or "figma" in title_low or "fof" in title_low:
                icon_to_use = ICON_COMM_FOF
            elif logo_low == "claude" or "claude" in title_low or "anthropic" in title_low:
                icon_to_use = ICON_COMM_CLAUDE
            elif logo_low == "devin" or "devin" in title_low or "cognition" in title_low:
                icon_to_use = ICON_COMM_DEVIN
            elif logo_low == "gdg" or "gdg" in title_low or "google developer" in title_low or "devfest" in title_low or "google" in title_low:
                icon_to_use = ICON_COMM_GDG
            else:
                icon_to_use = ICON_COMM_DEFAULT
        else:
            icon_to_use = ICON_REMINDER

        # 5 minutes before notification (between 0 and 310 seconds before event)
        if 0 <= diff_seconds <= 310 and not already_5min:
            mins_left = max(1, int(round(diff_seconds / 60)))
            time_label = f"{mins_left} min" if mins_left > 1 else "1 min"
            title = f"Reminder in {time_label}: {rem.get('title')}"
            body = f"Category: {rem.get('category', 'Personal')} | Time: {t_str}"
            if rem.get("notes"):
                body += f"\nNote: {rem['notes']}"
            try:
                subprocess.run([
                    "notify-send", "-a", "Reminders",
                    "-i", icon_to_use,
                    "-u", "normal",
                    "-t", "9000",
                    "-h", f"string:category:{rem.get('category', 'Personal')}",
                    title, body
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                play_sound("f1" if is_f1 else "message")
            except Exception:
                pass

            if rep == "none":
                rem["notified_5min"] = True
            else:
                rem["last_notified_5min_date"] = occ_str
            changed = True
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Sent alert for upcoming event: {rem.get('title')}", flush=True)

        # Exactly at due time (between -60 and 45 seconds)
        elif -60 <= diff_seconds <= 45 and not already_due:
            title = f"Event Due: {rem.get('title')}"
            body = f"Category: {rem.get('category', 'Personal')} | {t_str}"
            if rem.get("notes"):
                body += f"\n{rem['notes']}"
            try:
                subprocess.run([
                    "notify-send", "-a", "Reminders",
                    "-i", icon_to_use,
                    "-u", "critical",
                    "-t", "12000",
                    "-h", f"string:category:{rem.get('category', 'Personal')}",
                    title, body
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                play_sound("f1" if is_f1 else "alarm-clock-elapsed")
            except Exception:
                pass

            if rep == "none":
                rem["notified_due"] = True
            else:
                rem["last_notified_due_date"] = occ_str
            changed = True
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Sent due alert for: {rem.get('title')}", flush=True)

    if changed:
        save_reminders(reminders)

