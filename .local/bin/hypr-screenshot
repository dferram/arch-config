#!/usr/bin/env bash
# hypr-screenshot:
# Fast Wayland screenshot utility for Hyprland using grim, slurp, and swappy.
# Supports area selection, full screen, focused window, and annotation.

SAVE_DIR="${HOME}/Pictures/Screenshots"
mkdir -p "$SAVE_DIR"

TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
FILENAME="Screenshot_${TIMESTAMP}.png"
FILEPATH="${SAVE_DIR}/${FILENAME}"

MODE="${1:-area}"

notify_success() {
    notify-send -a "Screenshot" \
        -i "$FILEPATH" \
        -t 3500 \
        "Screenshot Captured" \
        "Saved to ~/Pictures/Screenshots and copied to clipboard."
}

cleanup_freeze() {
    qs ipc call freeze close >/dev/null 2>&1 || true
    rm -f /tmp/.shot_freeze_*.png
}

freeze_and_select() {
    local mons
    mons=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.disabled == false) | .name' 2>/dev/null)
    if [ -n "$mons" ]; then
        while IFS= read -r mon; do
            if [ -n "$mon" ]; then
                grim -o "$mon" "/tmp/.shot_freeze_${mon}.png" 2>/dev/null || rm -f "/tmp/.shot_freeze_${mon}.png" &
            fi
        done <<< "$mons"
        wait
        trap cleanup_freeze EXIT
        qs ipc call freeze open >/dev/null 2>&1 || true
        sleep 0.12
    fi
    slurp -d -c e22b31 -b 00000055 -s 00000000 2>/dev/null
}

case "$MODE" in
    "area"|"select"|"region")
        GEOM=$(freeze_and_select)
        if [ -z "$GEOM" ]; then
            cleanup_freeze
            exit 0
        fi
        grim -g "$GEOM" "$FILEPATH" || exit 1
        cleanup_freeze
        trap - EXIT
        wl-copy < "$FILEPATH"
        notify_success
        ;;
    "full"|"screen"|"all")
        grim "$FILEPATH" || exit 1
        wl-copy < "$FILEPATH"
        notify_success
        ;;
    "window"|"active")
        GEOM=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' 2>/dev/null)
        if [ -z "$GEOM" ] || [ "$GEOM" = "null,null nullxnull" ]; then
            grim "$FILEPATH" || exit 1
        else
            grim -g "$GEOM" "$FILEPATH" || exit 1
        fi
        wl-copy < "$FILEPATH"
        notify_success
        ;;
    "edit"|"swappy")
        GEOM=$(freeze_and_select)
        if [ -z "$GEOM" ]; then
            cleanup_freeze
            exit 0
        fi
        TMP_FILE="/tmp/screenshot_edit_${TIMESTAMP}.png"
        grim -g "$GEOM" "$TMP_FILE" || exit 1
        cleanup_freeze
        trap - EXIT
        swappy -f "$TMP_FILE" -o "$FILEPATH"
        rm -f "$TMP_FILE"
        if [ -f "$FILEPATH" ]; then
            wl-copy < "$FILEPATH"
            notify_success
        fi
        ;;
    *)
        echo "Usage: hypr-screenshot [area | full | window | edit]"
        exit 1
        ;;
esac
