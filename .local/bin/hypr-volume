#!/usr/bin/env python3
"""
hypr-volume:
Natural, human-calibrated perceptual volume management and OSD feedback.
Directly controls physical hardware audio sinks (speakers/headphones/bluetooth)
using a logarithmic/perceptual response curve.

Includes Hearing Protection features:
- High volume warning alert when raising volume above 45% (especially on headphones)
- Safe volume level enforcement
"""

import sys
import os
import subprocess
import re
import time
from pathlib import Path

# Perceptual mapping exponent (compensates for PipeWire/ALSA cubic scaling on laptop speakers)
PERCEPTUAL_EXP = 0.65
MAX_RAW = 65536
HEARING_WARNING_FILE = "/tmp/hypr_volume_hearing_warning"

def slider_to_raw(slider_pct):
    """Converts a user/slider percentage (0-100) to hardware 16-bit raw volume."""
    if slider_pct <= 0:
        return 0
    slider_pct = min(100, slider_pct)
    return round(MAX_RAW * ((slider_pct / 100.0) ** PERCEPTUAL_EXP))

def raw_to_slider(raw_val):
    """Converts hardware 16-bit raw volume back to user/slider percentage."""
    if raw_val <= 0:
        return 0
    raw_val = min(MAX_RAW, raw_val)
    return round(100.0 * ((raw_val / float(MAX_RAW)) ** (1.0 / PERCEPTUAL_EXP)))

def get_target_sink():
    try:
        out = subprocess.check_output(["pactl", "list", "sinks", "short"], stderr=subprocess.DEVNULL).decode()
        candidates = []
        for line in out.strip().split("\n"):
            parts = line.split()
            if len(parts) >= 2:
                name = parts[1]
                if "easyeffects" not in name:
                    candidates.append(name)

        # Priority 1: Wired headphones
        for name in candidates:
            if "headphone" in name.lower():
                return name
        # Priority 2: Bluetooth audio
        for name in candidates:
            if "bluez" in name.lower():
                return name
        # Priority 3: Internal laptop speakers
        for name in candidates:
            if "speaker" in name.lower():
                return name
        if candidates:
            return candidates[0]
    except Exception:
        pass
    return "@DEFAULT_SINK@"

def is_headphone_device(sink_name):
    lower = sink_name.lower()
    if any(k in lower for k in ["headphone", "bluez", "headset", "earbuds", "airpods"]):
        return True
    try:
        res = subprocess.run(
            ["amixer", "-c", "0", "cget", "iface=CARD,name='Headphone Jack'"],
            capture_output=True, text=True, check=False
        )
        if ": values=on" in res.stdout:
            return True
    except Exception:
        pass
    try:
        out = subprocess.check_output(["pactl", "list", "sinks"], stderr=subprocess.DEVNULL).decode()
        if "Active Port: [Out] Headphones" in out or 'device.icon_name = "audio-headphones"' in out:
            return True
    except Exception:
        pass
    return False

def get_volume_info(sink):
    try:
        vol_out = subprocess.check_output(["pactl", "get-sink-volume", sink], stderr=subprocess.DEVNULL).decode()
        mute_out = subprocess.check_output(["pactl", "get-sink-mute", sink], stderr=subprocess.DEVNULL).decode()
        is_muted = "yes" in mute_out.lower()

        # Extract 16-bit raw integer for exact bijection
        m_raw = re.search(r"(\d+)\s*/", vol_out)
        if m_raw:
            raw_val = int(m_raw.group(1))
            return raw_to_slider(raw_val), is_muted

        # Fallback to percentage
        m = re.search(r"(\d+)%", vol_out)
        hw_pct = int(m.group(1)) if m else 0
        slider_pct = round(100.0 * ((hw_pct / 100.0) ** (1.0 / PERCEPTUAL_EXP)))
        return slider_pct, is_muted
    except Exception:
        pass
    return 0, False

def notify_hearing_protection(pct, sink):
    try:
        subprocess.run([
            "notify-send",
            "-a", "Hearing Protection",
            "-i", "dialog-warning",
            "-u", "normal",
            "-t", "3000",
            "-h", "string:desktop-entry:hyprland",
            "-h", "string:category:hearing.safety",
            "High Volume Warning",
            f"Volume > 45% ({pct}%). Protect your ears."
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def check_hearing_safety(current_slider, new_slider, sink):
    if new_slider <= 45:
        try:
            if os.path.exists(HEARING_WARNING_FILE):
                os.remove(HEARING_WARNING_FILE)
        except Exception:
            pass
        return

    now = time.time()
    last_warn = 0
    if os.path.exists(HEARING_WARNING_FILE):
        try:
            with open(HEARING_WARNING_FILE, "r") as f:
                last_warn = float(f.read().strip())
        except Exception:
            last_warn = 0

    crossed_threshold = (current_slider <= 45 and new_slider > 45)
    cooldown_expired = (now - last_warn > 15.0)

    if crossed_threshold or cooldown_expired:
        try:
            with open(HEARING_WARNING_FILE, "w") as f:
                f.write(str(now))
        except Exception:
            pass

        notify_hearing_protection(new_slider, sink)

def notify_volume(pct, is_muted, sink="@DEFAULT_SINK@"):
    if is_muted:
        icon = "audio-volume-muted-symbolic"
        title = "Volume Muted"
    else:
        if pct == 0:
            icon = "audio-volume-muted-symbolic"
        elif pct < 33:
            icon = "audio-volume-low-symbolic"
        elif pct < 66:
            icon = "audio-volume-medium-symbolic"
        else:
            icon = "audio-volume-high-symbolic"

        if pct > 45 and is_headphone_device(sink):
            title = f"Volume {pct}% (High Volume)"
        else:
            title = f"Volume {pct}%"

    try:
        subprocess.run([
            "notify-send", "-a", "Volume",
            "-i", icon,
            "-t", "1200",
            "-h", "string:x-canonical-private-synchronous:volume",
            "-h", "string:synchronous:volume",
            "-h", f"int:value:{pct}",
            "-h", f"boolean:muted:{'true' if is_muted else 'false'}",
            title
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    sink = get_target_sink()

    if len(sys.argv) < 2:
        pct, muted = get_volume_info(sink)
        print(f"{'MUTED ' if muted else ''}{pct}%")
        return

    action = sys.argv[1].lower().strip()
    step = 1
    if len(sys.argv) > 2:
        try:
            step = int(sys.argv[2].replace("%", ""))
        except ValueError:
            step = 1

    current_slider, muted = get_volume_info(sink)

    if action in ["up", "+", "raise"]:
        new_slider = min(100, current_slider + step)
        raw_val = slider_to_raw(new_slider)
        subprocess.run(["pactl", "set-sink-volume", sink, str(raw_val)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        notify_volume(new_slider, muted, sink)
        check_hearing_safety(current_slider, new_slider, sink)
    elif action in ["down", "-", "lower"]:
        new_slider = max(0, current_slider - step)
        raw_val = slider_to_raw(new_slider)
        subprocess.run(["pactl", "set-sink-volume", sink, str(raw_val)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        notify_volume(new_slider, muted, sink)
        check_hearing_safety(current_slider, new_slider, sink)
    elif action in ["mute", "toggle", "m"]:
        subprocess.run(["pactl", "set-sink-mute", sink, "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        pct, is_m = get_volume_info(sink)
        notify_volume(pct, is_m, sink)
    elif action in ["set", "s"]:
        if len(sys.argv) > 2:
            try:
                target = int(sys.argv[2].replace("%", ""))
                target = max(0, min(100, target))
                raw_val = slider_to_raw(target)
                subprocess.run(["pactl", "set-sink-volume", sink, str(raw_val)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                notify_volume(target, muted, sink)
                check_hearing_safety(current_slider, target, sink)
            except ValueError:
                print("Usage: hypr-volume set <percentage>")
    elif action in ["get", "status"]:
        pct, is_m = get_volume_info(sink)
        print(f"{'MUTED ' if is_m else ''}{pct}%")
    else:
        print("Usage: hypr-volume [up | down | mute | set <pct> | get]")

if __name__ == "__main__":
    main()
