#!/usr/bin/env python3
"""
hypr-volume:
Volume management and OSD feedback via WirePlumber / wpctl.
"""

import sys
import subprocess

def get_volume_info():
    try:
        out = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], stderr=subprocess.DEVNULL).decode().strip()
        # Output format: "Volume: 0.65" or "Volume: 0.65 [MUTED]"
        is_muted = "[MUTED]" in out
        parts = out.replace("[MUTED]", "").replace("Volume:", "").strip().split()
        if parts:
            vol_float = float(parts[0])
            pct = round(vol_float * 100)
            return pct, is_muted
    except Exception:
        pass
    return 0, False

def notify_volume(pct, is_muted):
    if is_muted:
        icon = "audio-volume-muted-symbolic"
        title = "Volume Muted"
        val = 0
    else:
        if pct == 0:
            icon = "audio-volume-muted-symbolic"
        elif pct < 33:
            icon = "audio-volume-low-symbolic"
        elif pct < 66:
            icon = "audio-volume-medium-symbolic"
        else:
            icon = "audio-volume-high-symbolic"
        title = f"Volume {pct}%"
        val = pct

    try:
        subprocess.run([
            "notify-send", "-a", "Volume",
            "-i", icon,
            "-t", "1500",
            "-h", f"int:value:{val}",
            "-h", "string:x-canonical-private-synchronous:volume",
            "-h", "string:synchronous:volume",
            title
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    if len(sys.argv) < 2:
        pct, muted = get_volume_info()
        print(f"{'MUTED ' if muted else ''}{pct}%")
        return

    action = sys.argv[1].lower().strip()
    step = 5
    if len(sys.argv) > 2:
        try:
            step = int(sys.argv[2].replace("%", ""))
        except ValueError:
            step = 5

    if action in ["up", "+", "raise"]:
        subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", f"{step}%+"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        pct, muted = get_volume_info()
        notify_volume(pct, muted)
    elif action in ["down", "-", "lower"]:
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{step}%-"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        pct, muted = get_volume_info()
        notify_volume(pct, muted)
    elif action in ["mute", "toggle", "m"]:
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        pct, muted = get_volume_info()
        notify_volume(pct, muted)
    elif action in ["set", "s"]:
        if len(sys.argv) > 2:
            try:
                target = int(sys.argv[2].replace("%", ""))
                target = max(0, min(100, target))
                subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", f"{target / 100.0}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                pct, muted = get_volume_info()
                notify_volume(pct, muted)
            except ValueError:
                print("Usage: hypr-volume set <percentage>")
    elif action in ["get", "status"]:
        pct, muted = get_volume_info()
        print(f"{'MUTED ' if muted else ''}{pct}%")
    else:
        print("Usage: hypr-volume [up | down | mute | set <pct> | get]")

if __name__ == "__main__":
    main()
