#!/usr/bin/env python3
"""
hypr-volume:
Natural, human-calibrated perceptual volume management and OSD feedback.
Directly controls physical hardware audio sinks (speakers/headphones/bluetooth)
using a logarithmic/perceptual response curve.

Fixes the common Linux issue where 50% sounds too quiet and 10-15% is silent,
delivering smooth, predictable volume scaling across the entire 0-100% range.
"""

import sys
import subprocess
import re
from pathlib import Path

# Perceptual mapping exponent (compensates for PipeWire/ALSA cubic scaling on laptop speakers)
PERCEPTUAL_EXP = 0.65

def slider_to_hardware(slider_pct):
    """Converts a user/slider percentage (0-100) to hardware pactl percentage."""
    if slider_pct <= 0:
        return 0
    slider_pct = min(100, slider_pct)
    return round(100.0 * ((slider_pct / 100.0) ** PERCEPTUAL_EXP))

def hardware_to_slider(hw_pct):
    """Converts hardware pactl percentage back to user/slider percentage."""
    if hw_pct <= 0:
        return 0
    hw_pct = min(100, hw_pct)
    return round(100.0 * ((hw_pct / 100.0) ** (1.0 / PERCEPTUAL_EXP)))

def get_target_sink():
    try:
        out = subprocess.check_output(["pactl", "list", "sinks", "short"], stderr=subprocess.DEVNULL).decode()
        candidates = []
        for line in out.strip().split("\n"):
            parts = line.split()
            if len(parts) >= 2:
                name = parts[1]
                if "easyeffects" not in name:
                    candidates.append(name)

        # Priority 1: Wired headphones
        for name in candidates:
            if "headphone" in name.lower():
                return name
        # Priority 2: Bluetooth audio
        for name in candidates:
            if "bluez" in name.lower():
                return name
        # Priority 3: Internal laptop speakers
        for name in candidates:
            if "speaker" in name.lower():
                return name
        if candidates:
            return candidates[0]
    except Exception:
        pass
    return "@DEFAULT_SINK@"

def get_volume_info(sink):
    try:
        vol_out = subprocess.check_output(["pactl", "get-sink-volume", sink], stderr=subprocess.DEVNULL).decode()
        mute_out = subprocess.check_output(["pactl", "get-sink-mute", sink], stderr=subprocess.DEVNULL).decode()
        is_muted = "yes" in mute_out.lower()
        m = re.search(r"(\d+)%", vol_out)
        hw_pct = int(m.group(1)) if m else 0
        slider_pct = hardware_to_slider(hw_pct)
        return slider_pct, is_muted
    except Exception:
        pass
    return 0, False

def get_accent_color():
    try:
        qml_path = Path.home() / ".config/quickshell/theme/Theme.qml"
        if qml_path.exists():
            m = re.search(r'readonly property color blue:\s*"([^"]+)"', qml_path.read_text())
            if m:
                return m.group(1)
    except Exception:
        pass
    return "#e22b31"

def notify_volume(pct, is_muted):
    if is_muted:
        icon = "audio-volume-muted-symbolic"
        title = "Volume Muted"
    else:
        if pct == 0:
            icon = "audio-volume-muted-symbolic"
        elif pct < 33:
            icon = "audio-volume-low-symbolic"
        elif pct < 66:
            icon = "audio-volume-medium-symbolic"
        else:
            icon = "audio-volume-high-symbolic"
        title = f"Volume {pct}%"

    try:
        subprocess.run([
            "notify-send", "-a", "Volume",
            "-i", icon,
            "-t", "1200",
            "-h", "string:x-canonical-private-synchronous:volume",
            "-h", "string:synchronous:volume",
            "-h", f"int:value:{pct}",
            "-h", f"boolean:muted:{'true' if is_muted else 'false'}",
            title
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    sink = get_target_sink()

    if len(sys.argv) < 2:
        pct, muted = get_volume_info(sink)
        print(f"{'MUTED ' if muted else ''}{pct}%")
        return

    action = sys.argv[1].lower().strip()
    step = 2
    if len(sys.argv) > 2:
        try:
            step = int(sys.argv[2].replace("%", ""))
        except ValueError:
            step = 2

    current_slider, muted = get_volume_info(sink)

    if action in ["up", "+", "raise"]:
        new_slider = min(100, current_slider + step)
        hw_val = slider_to_hardware(new_slider)
        subprocess.run(["pactl", "set-sink-volume", sink, f"{hw_val}%"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        notify_volume(new_slider, muted)
    elif action in ["down", "-", "lower"]:
        new_slider = max(0, current_slider - step)
        hw_val = slider_to_hardware(new_slider)
        subprocess.run(["pactl", "set-sink-volume", sink, f"{hw_val}%"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        notify_volume(new_slider, muted)
    elif action in ["mute", "toggle", "m"]:
        subprocess.run(["pactl", "set-sink-mute", sink, "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        pct, is_m = get_volume_info(sink)
        notify_volume(pct, is_m)
    elif action in ["set", "s"]:
        if len(sys.argv) > 2:
            try:
                target = int(sys.argv[2].replace("%", ""))
                target = max(0, min(100, target))
                hw_val = slider_to_hardware(target)
                subprocess.run(["pactl", "set-sink-volume", sink, f"{hw_val}%"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                notify_volume(target, muted)
            except ValueError:
                print("Usage: hypr-volume set <percentage>")
    elif action in ["get", "status"]:
        pct, is_m = get_volume_info(sink)
        print(f"{'MUTED ' if is_m else ''}{pct}%")
    else:
        print("Usage: hypr-volume [up | down | mute | set <pct> | get]")

if __name__ == "__main__":
    main()
