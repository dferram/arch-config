#!/usr/bin/env python3
"""
hypr-night-mode:
Manage blue light filter across all monitors smoothly using hyprsunset.
No shaders, no multi-monitor flickering, applies to eDP-1 and external monitors.
"""

import sys
import subprocess
from pathlib import Path

STATE_FILE = Path.home() / ".local" / "state" / "hypr-night-mode"

def is_active():
    return STATE_FILE.exists()

def set_night_mode(enabled: bool):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    
    if enabled:
        # Enable 4200K warm tone
        try:
            subprocess.run(["hyprctl", "hyprsunset", "temperature", "4200"], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            STATE_FILE.write_text("on")
        except Exception as e:
            print(f"Error enabling night mode: {e}", file=sys.stderr)
            return False
        
        title = "Night Light"
        msg = "Warm color temperature enabled (4200K)"
        icon = "weather-clear-night"
    else:
        # Disable (restore identity color matrix)
        try:
            subprocess.run(["hyprctl", "hyprsunset", "identity"], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if STATE_FILE.exists():
                STATE_FILE.unlink()
        except Exception as e:
            print(f"Error disabling night mode: {e}", file=sys.stderr)
            return False
            
        title = "Night Light"
        msg = "Night Light disabled (standard color)"
        icon = "display-brightness-symbolic"

    try:
        subprocess.run([
            "notify-send", "-a", "Night Light",
            "-i", icon,
            "-t", "2000",
            "-h", "string:x-canonical-private-synchronous:nightlight",
            "-h", "string:synchronous:nightlight",
            title, msg
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    return True

def main():
    arg = (sys.argv[1].lower() if len(sys.argv) > 1 else "toggle").strip()
    if arg in ["status", "-s", "--status"]:
        st = is_active()
        print("on" if st else "off")
        sys.exit(0 if st else 1)
    elif arg in ["on", "enable", "1"]:
        set_night_mode(True)
    elif arg in ["off", "disable", "0"]:
        set_night_mode(False)
    elif arg in ["toggle", "-t"]:
        set_night_mode(not is_active())
    else:
        print("Usage: hypr-night-mode [on | off | toggle | status]")

if __name__ == "__main__":
    main()
