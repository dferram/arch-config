#!/usr/bin/env python3
"""
hypr-night-mode:
Manage blue light filter across all monitors smoothly using hyprsunset.
No shaders, applies to eDP-1 and external monitors.
"""

import sys
import subprocess
from pathlib import Path

STATE_FILE = Path.home() / ".local" / "state" / "hypr-night-mode"

def is_active():
    try:
        res = subprocess.run(["pgrep", "-x", "hyprsunset"], stdout=subprocess.DEVNULL)
        return res.returncode == 0
    except Exception:
        return STATE_FILE.exists()

def set_night_mode(enabled: bool):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    
    if enabled:
        # Kill any existing instance and start hyprsunset with 4200K warm tone
        subprocess.run(["killall", "-q", "-9", "hyprsunset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["hyprsunset", "-t", "4200"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        STATE_FILE.write_text("on")
        
        title = "Night Light Enabled"
        msg = "Warm temperature (4200K)"
        icon = "weather-clear-night"
    else:
        # Kill hyprsunset to restore normal screen colors
        subprocess.run(["killall", "-q", "hyprsunset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if STATE_FILE.exists():
            STATE_FILE.unlink()
            
        title = "Night Light Disabled"
        msg = "Standard temperature"
        icon = "display-brightness-symbolic"

    try:
        subprocess.run([
            "notify-send", "-a", "Night Light",
            "-i", icon,
            "-t", "1500",
            "-h", "string:x-canonical-private-synchronous:nightlight",
            "-h", "string:synchronous:nightlight",
            "-h", f"boolean:active:{'true' if enabled else 'false'}",
            title, msg
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    return True

def main():
    arg = (sys.argv[1].lower() if len(sys.argv) > 1 else "toggle").strip()
    if arg in ["status", "-s", "--status"]:
        st = is_active()
        print("on" if st else "off")
        sys.exit(0 if st else 1)
    elif arg in ["on", "enable", "1"]:
        set_night_mode(True)
    elif arg in ["off", "disable", "0"]:
        set_night_mode(False)
    elif arg in ["toggle", "-t"]:
        set_night_mode(not is_active())
    else:
        print("Usage: hypr-night-mode [on | off | toggle | status]")

if __name__ == "__main__":
    main()
