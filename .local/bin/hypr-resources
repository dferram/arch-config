#!/usr/bin/env python3
import json
import os
import time
from pathlib import Path

CACHE_FILE = Path("/tmp/hypr_resources_cache.json")
CACHE_TTL = 0.85  # Share telemetry across widgets if called within 850ms
STATE_FILE = Path("/tmp/hypr_cpu_stat.tmp")

# Fast path: Serve fresh cache if available
try:
    if CACHE_FILE.exists():
        now = time.time()
        mtime = CACHE_FILE.stat().st_mtime
        if (now - mtime) < CACHE_TTL:
            cached_text = CACHE_FILE.read_text().strip()
            if cached_text:
                print(cached_text)
                exit(0)
except Exception:
    pass

def get_cpu():
    try:
        now = time.time()
        with open("/proc/stat", "r") as f:
            first = f.readline()
        parts = [int(x) for x in first.split()[1:]]
        # user, nice, system, idle, iowait, irq, softirq, steal
        total = sum(parts[:8])
        idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
        
        prev_time, prev_total, prev_idle, prev_pct = None, None, None, 0
        if STATE_FILE.exists():
            try:
                txt = STATE_FILE.read_text().split()
                if len(txt) >= 3:
                    prev_time = float(txt[0])
                    prev_total = int(txt[1])
                    prev_idle = int(txt[2])
                    if len(txt) >= 4:
                        prev_pct = int(txt[3])
            except Exception:
                pass
        
        pct = prev_pct
        if prev_total is not None and total > prev_total and prev_time is not None:
            dt = now - prev_time
            # Require at least 400ms delta to prevent jiffy quantization spikes
            if dt >= 0.4:
                d_tot = total - prev_total
                d_idl = idle - prev_idle
                if d_tot > 0:
                    raw_pct = round(100.0 * (d_tot - d_idl) / d_tot)
                    pct = max(0, min(100, raw_pct))
                    tmp_state = f"{STATE_FILE}.{os.getpid()}"
                    Path(tmp_state).write_text(f"{now} {total} {idle} {pct}")
                    os.replace(tmp_state, STATE_FILE)
                    return pct

        if prev_total is None:
            time.sleep(0.06)
            with open("/proc/stat", "r") as f:
                first2 = f.readline()
            parts2 = [int(x) for x in first2.split()[1:]]
            total2 = sum(parts2[:8])
            idle2 = parts2[3] + (parts2[4] if len(parts2) > 4 else 0)
            d_tot = total2 - total
            d_idl = idle2 - idle
            if d_tot > 0:
                raw_pct = round(100.0 * (d_tot - d_idl) / d_tot)
                pct = max(0, min(100, raw_pct))
            tmp_state = f"{STATE_FILE}.{os.getpid()}"
            Path(tmp_state).write_text(f"{now + 0.06} {total2} {idle2} {pct}")
            os.replace(tmp_state, STATE_FILE)
            return pct

        return pct
    except Exception:
        return 0

def get_ram():
    try:
        mem = {}
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    mem[parts[0].strip()] = int(parts[1].split()[0])
        total_kb = mem.get("MemTotal", 1)
        avail_kb = mem.get("MemAvailable", 0)
        used_kb = total_kb - avail_kb
        pct = round(100.0 * used_kb / total_kb)
        used_gb = round(used_kb / 1048576, 1)
        total_gb = round(total_kb / 1048576, 1)
        return pct, used_gb, total_gb
    except Exception:
        return 0, 0, 0

def get_temp():
    try:
        for hw in Path("/sys/class/hwmon").glob("hwmon*"):
            name_file = hw / "name"
            if name_file.exists() and name_file.read_text().strip() in ("coretemp", "k10temp", "cpu_thermal", "zenpower"):
                for tf in hw.glob("temp*_input"):
                    label_file = Path(str(tf).replace("_input", "_label"))
                    if label_file.exists() and "Package" in label_file.read_text():
                        val = int(tf.read_text().strip())
                        if val > 0:
                            return round(val / 1000)
                t1 = hw / "temp1_input"
                if t1.exists():
                    val = int(t1.read_text().strip())
                    if val > 0:
                        return round(val / 1000)

        for tz in Path("/sys/class/thermal").glob("thermal_zone*"):
            type_file = tz / "type"
            temp_file = tz / "temp"
            if type_file.exists() and temp_file.exists():
                z_type = type_file.read_text().strip()
                if z_type in ("x86_pkg_temp", "TCPU", "cpu_thermal"):
                    val = int(temp_file.read_text().strip())
                    if 0 < val < 150000:
                        return round(val / 1000)
    except Exception:
        pass
    return 0

def get_fan():
    max_rpm = 0
    try:
        for hw in Path("/sys/class/hwmon").glob("hwmon*"):
            for fan in hw.glob("fan*_input"):
                try:
                    rpm = int(fan.read_text().strip())
                    if rpm > max_rpm:
                        max_rpm = rpm
                except Exception:
                    pass
    except Exception:
        pass
    return max_rpm

def get_freq():
    try:
        freqs = []
        for f in Path("/sys/devices/system/cpu").glob("cpu[0-9]*/cpufreq/scaling_cur_freq"):
            try:
                freqs.append(int(f.read_text().strip()))
            except Exception:
                pass
        if freqs:
            return round(sum(freqs) / len(freqs) / 1000000, 2)
    except Exception:
        pass
    return 0.0

def get_thermald():
    try:
        if Path("/run/thermald/thermald.pid").exists():
            return True
        return os.path.exists("/proc/1") and os.system("pgrep -x thermald >/dev/null 2>&1") == 0
    except Exception:
        return False

CPU_INFO_CACHE = None
def get_cpu_info():
    global CPU_INFO_CACHE
    if CPU_INFO_CACHE is not None:
        return CPU_INFO_CACHE
    try:
        with open("/proc/cpuinfo") as f:
            for line in f:
                if "model name" in line:
                    c = line.split(":")[1].strip()
                    c = c.replace("Intel(R) Core(TM) ", "").replace("Intel(R) ", "").replace("AMD Ryzen ", "Ryzen ")
                    c = c.split(" @ ")[0].strip()
                    short = " ".join(c.split()[:2]) if "Ultra" in c else c
                    CPU_INFO_CACHE = (short, c)
                    return CPU_INFO_CACHE
    except Exception:
        pass
    CPU_INFO_CACHE = ("Ultra 5", "Ultra 5 125H")
    return CPU_INFO_CACHE

def main():
    cpu = get_cpu()
    ram_pct, ram_used, ram_total = get_ram()
    temp = get_temp()
    fan_rpm = get_fan()
    freq_ghz = get_freq()
    thermald_active = get_thermald()
    cpu_short, cpu_full = get_cpu_info()
    
    out = json.dumps({
        "cpu": cpu,
        "ram_pct": ram_pct,
        "ram_used": ram_used,
        "ram_total": ram_total,
        "temp": temp,
        "fan": fan_rpm,
        "freq": freq_ghz,
        "thermald": thermald_active,
        "cpu_name": cpu_short,
        "cpu_full": cpu_full
    })

    try:
        tmp_cache = f"{CACHE_FILE}.{os.getpid()}"
        Path(tmp_cache).write_text(out)
        os.replace(tmp_cache, CACHE_FILE)
    except Exception:
        pass

    print(out)

if __name__ == "__main__":
    main()
