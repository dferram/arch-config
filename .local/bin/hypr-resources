#!/usr/bin/env python3
import json
import time
from pathlib import Path

STATE_FILE = Path("/tmp/hypr_cpu_stat.tmp")

def get_cpu():
    try:
        with open("/proc/stat", "r") as f:
            first = f.readline()
        parts = [int(x) for x in first.split()[1:]]
        total = sum(parts)
        idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
        
        prev_total, prev_idle = None, None
        if STATE_FILE.exists():
            try:
                txt = STATE_FILE.read_text().split()
                if len(txt) == 2:
                    prev_total, prev_idle = int(txt[0]), int(txt[1])
            except Exception:
                pass
        
        STATE_FILE.write_text(f"{total} {idle}")
        
        if prev_total is not None and total > prev_total:
            d_tot = total - prev_total
            d_idl = idle - prev_idle
            pct = round(100.0 * (d_tot - d_idl) / d_tot)
            return max(0, min(100, pct))
    except Exception:
        pass
    return 0

def get_ram():
    try:
        mem = {}
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    mem[parts[0].strip()] = int(parts[1].split()[0])
        total_kb = mem.get("MemTotal", 1)
        avail_kb = mem.get("MemAvailable", 0)
        used_kb = total_kb - avail_kb
        pct = round(100.0 * used_kb / total_kb)
        used_gb = round(used_kb / 1048576, 1)
        total_gb = round(total_kb / 1048576, 1)
        return pct, used_gb, total_gb
    except Exception:
        return 0, 0, 0

def get_temp():
    try:
        tz = Path("/sys/class/thermal/thermal_zone0/temp")
        if tz.exists():
            return round(int(tz.read_text().strip()) / 1000)
    except Exception:
        pass
    return 0

def main():
    cpu = get_cpu()
    ram_pct, ram_used, ram_total = get_ram()
    temp = get_temp()
    
    print(json.dumps({
        "cpu": cpu,
        "ram_pct": ram_pct,
        "ram_used": ram_used,
        "ram_total": ram_total,
        "temp": temp
    }))

if __name__ == "__main__":
    main()
