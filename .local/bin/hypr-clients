#!/usr/bin/env python3
import json
import subprocess
import os
import sys
import glob

KNOWN_TOOLS = (
    "codex", "openai-codex", "agy", "antigravity", "gemini", "claude",
    "chatgpt", "sgpt", "ollama", "copilot", "deepseek", "aider",
    "lazydocker", "docker", "podman", "lazygit", "git", "gh", "nvim", "neovim", "vim",
    "btop", "htop", "nvtop", "cava", "psql",
    "node", "nodemon", "npm", "npx", "vite", "next", "pnpm", "bun"
)

SHELLS_AND_HELPERS = (
    "bash", "zsh", "fish", "sh", "dash", "csh", "tcsh",
    "kitten", "kitty", "systemd", "systemd-user", "gnome-pty-helper"
)

INTERPRETERS = ("python", "python3", "node", "bun", "deno", "ruby", "perl", "sh", "bash")

def is_git_repo(path):
    if not path:
        return False
    try:
        cur = os.path.realpath(path)
        while cur and cur != "/":
            if os.path.exists(os.path.join(cur, ".git")):
                return True
            parent = os.path.dirname(cur)
            if parent == cur:
                break
            cur = parent
    except Exception:
        pass
    return False

def get_terminal_git_context(pid):
    for child in get_children(pid):
        try:
            cwd = os.readlink(f"/proc/{child}/cwd")
            if is_git_repo(cwd):
                return True
        except Exception:
            pass
    return False

def get_terminal_colgate_context(pid):
    for child in get_children(pid):
        try:
            cwd = os.readlink(f"/proc/{child}/cwd")
            if "colgate" in cwd.lower() or "colpal" in cwd.lower():
                return True
        except Exception:
            pass
    return False

def get_children(pid):
    pids = set()
    for child_path in glob.glob(f"/proc/{pid}/task/*/children"):
        try:
            with open(child_path, "r") as f:
                for p in f.read().split():
                    pids.add(int(p))
        except Exception:
            pass
    return list(pids)

def inspect_process(pid):
    try:
        with open(f"/proc/{pid}/comm", "r") as f:
            comm = f.read().strip()
    except Exception:
        return None

    try:
        with open(f"/proc/{pid}/cmdline", "rb") as cf:
            cmd = cf.read().decode("utf-8", errors="ignore").lower()
            for tool in KNOWN_TOOLS:
                if tool in cmd:
                    return tool
    except Exception:
        pass

    comm_lower = comm.lower()
    for tool in KNOWN_TOOLS:
        if tool == comm_lower or tool in comm_lower:
            return tool

    if comm in SHELLS_AND_HELPERS:
        children = get_children(pid)
        for child_pid in children:
            res = inspect_process(child_pid)
            if res:
                return res
        return None

    if comm in INTERPRETERS:
        children = get_children(pid)
        for child_pid in children:
            res = inspect_process(child_pid)
            if res:
                return res
        return comm

    return comm

def get_foreground_process(pid):
    children = get_children(pid)
    for child_pid in children:
        found = inspect_process(child_pid)
        if found:
            return found
    return None

try:
    raw = subprocess.check_output(["hyprctl", "clients", "-j"])
    clients = json.loads(raw)
    for c in clients:
        cls = (c.get("class") or "").lower()
        if any(term in cls for term in ("kitty", "terminal", "alacritty", "foot", "wezterm", "xterm")):
            pid = c.get("pid")
            if pid:
                is_colgate = get_terminal_colgate_context(pid)
                if is_colgate:
                    c["isColgate"] = True
                fg = get_foreground_process(pid)
                if fg:
                    c["processName"] = fg
                    current_title = c.get("title") or ""
                    if fg not in current_title.lower():
                        c["title"] = f"{fg} - {current_title}" if current_title else fg
                else:
                    if is_colgate:
                        c["processName"] = "colgate"
                    elif get_terminal_git_context(pid):
                        c["processName"] = "git"
                        c["isGitRepo"] = True
    print(json.dumps(clients))
except Exception:
    subprocess.run(["hyprctl", "clients", "-j"])
