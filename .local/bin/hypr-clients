#!/usr/bin/env python3
import json
import subprocess
import os
import sys
import glob
import re
import sqlite3
import struct
import urllib.parse

KNOWN_TOOLS = (
    "devin", "codex", "openai-codex", "agy", "antigravity", "gemini", "claude",
    "chatgpt", "sgpt", "ollama", "copilot", "deepseek", "aider",
    "lazydocker", "docker", "podman", "lazygit", "git", "gh", "nvim", "neovim", "vim",
    "btop", "htop", "nvtop", "cava", "psql",
    "node", "nodemon", "npm", "npx", "vite", "next", "pnpm", "bun"
)

SHELLS_AND_HELPERS = (
    "bash", "zsh", "fish", "sh", "dash", "csh", "tcsh",
    "kitten", "kitty", "systemd", "systemd-user", "gnome-pty-helper"
)

INTERPRETERS = ("python", "python3", "node", "bun", "deno", "ruby", "perl", "sh", "bash")

def is_git_repo(path):
    if not path:
        return False
    try:
        cur = os.path.realpath(path)
        while cur and cur != "/":
            if os.path.exists(os.path.join(cur, ".git")):
                return True
            parent = os.path.dirname(cur)
            if parent == cur:
                break
            cur = parent
    except Exception:
        pass
    return False

def get_terminal_git_context(pid):
    for child in get_children(pid):
        try:
            cwd = os.readlink(f"/proc/{child}/cwd")
            if is_git_repo(cwd):
                return True
        except Exception:
            pass
    return False

def get_terminal_colgate_context(pid):
    for child in get_children(pid):
        try:
            cwd = os.readlink(f"/proc/{child}/cwd")
            if "colgate" in cwd.lower() or "colpal" in cwd.lower():
                return True
        except Exception:
            pass
    return False

def get_children(pid):
    pids = set()
    for child_path in glob.glob(f"/proc/{pid}/task/*/children"):
        try:
            with open(child_path, "r") as f:
                for p in f.read().split():
                    pids.add(int(p))
        except Exception:
            pass
    return list(pids)

def inspect_process(pid):
    try:
        with open(f"/proc/{pid}/comm", "r") as f:
            comm = f.read().strip()
    except Exception:
        return None

    try:
        with open(f"/proc/{pid}/cmdline", "rb") as cf:
            cmd = cf.read().decode("utf-8", errors="ignore").lower()
            # Match Devin's executable, not a prompt mentioning Devin or a model.
            executable = os.path.basename(cmd.split("\0", 1)[0])
            if executable in ("devin", "devin-cli"):
                return "devin"
            for tool in KNOWN_TOOLS:
                if tool == "devin":
                    continue
                if tool in cmd:
                    return tool
    except Exception:
        pass

    comm_lower = comm.lower()
    for tool in KNOWN_TOOLS:
        if tool == comm_lower or tool in comm_lower:
            return tool

    if comm in SHELLS_AND_HELPERS:
        children = get_children(pid)
        for child_pid in children:
            res = inspect_process(child_pid)
            if res:
                return res
        return None

    if comm in INTERPRETERS:
        children = get_children(pid)
        for child_pid in children:
            res = inspect_process(child_pid)
            if res:
                return res
        return comm

    return comm

def get_foreground_process(pid):
    children = get_children(pid)
    for child_pid in children:
        found = inspect_process(child_pid)
        if found:
            return found
    return None

def get_stremio_active_names():
    """Names of torrents Stremio is currently streaming (local server stats)."""
    try:
        import urllib.request
        with urllib.request.urlopen("http://127.0.0.1:11470/stats.json", timeout=0.4) as r:
            data = json.loads(r.read().decode("utf-8", errors="ignore"))
        names = []
        for t in data.values():
            if not isinstance(t, dict) or t.get("swarmPaused"):
                continue
            if t.get("wires") or t.get("swarmConnections"):
                n = t.get("name")
                if n:
                    names.append(n)
        return names
    except Exception:
        return []

def get_chromium_title_url_maps():
    """Map browser page titles to URLs across Chromium/Chrome/Brave profiles."""
    events = []
    profile_globs = (
        "~/.config/chromium/*",
        "~/.config/google-chrome/*",
        "~/.config/BraveSoftware/Brave-Browser/*",
    )
    profile_dirs = []
    for pattern in profile_globs:
        for path in glob.glob(os.path.expanduser(pattern)):
            if os.path.isdir(path):
                profile_dirs.append(path)

    for prof_dir in profile_dirs:
        hist_path = os.path.join(prof_dir, "History")
        if os.path.isfile(hist_path):
            try:
                con = sqlite3.connect(f"file:{hist_path}?immutable=1", uri=True)
                rows = con.execute(
                    "SELECT last_visit_time, title, url FROM urls "
                    "WHERE title != '' AND url != '' "
                    "ORDER BY last_visit_time DESC LIMIT 1500"
                ).fetchall()
                con.close()
                for idx, (lvt, title, url) in enumerate(rows):
                    ts = (lvt / 1_000_000.0) - 11644473600.0 if lvt else 0.0
                    events.append((ts, -idx, title, url))
            except Exception:
                pass

        sess_dir = os.path.join(prof_dir, "Sessions")
        if not os.path.isdir(sess_dir):
            continue
        session_files = []
        tabs_files = sorted(glob.glob(os.path.join(sess_dir, "Tabs_*")), key=os.path.getmtime)[-2:]
        sess_files = sorted(glob.glob(os.path.join(sess_dir, "Session_*")), key=os.path.getmtime)[-3:]
        for fpath in tabs_files:
            session_files.append((fpath, 1))
        for fpath in sess_files:
            session_files.append((fpath, 6))

        for fpath, target_cmd in session_files:
            try:
                mtime = os.path.getmtime(fpath)
                with open(fpath, "rb") as sf:
                    data = sf.read()
                if data[:4] != b"SNSS":
                    continue
                pos = 8
                seq = 0
                while pos + 2 <= len(data):
                    size = struct.unpack_from("<H", data, pos)[0]
                    pos += 2
                    if size == 0 or pos + size > len(data):
                        break
                    cmd = data[pos]
                    payload = data[pos + 1 : pos + size]
                    pos += size
                    if cmd == target_cmd and len(payload) >= 16:
                        _, _, _, url_len = struct.unpack_from("<IIII", payload, 0)
                        if 0 < url_len < len(payload) - 16:
                            url = payload[16 : 16 + url_len].decode("utf-8", "ignore")
                            t_off = 16 + ((url_len + 3) & ~3)
                            if t_off + 4 <= len(payload):
                                title_chars = struct.unpack_from("<I", payload, t_off)[0]
                                t_start = t_off + 4
                                t_end = t_start + title_chars * 2
                                if t_end <= len(payload):
                                    title = payload[t_start:t_end].decode("utf-16-le", "ignore")
                                    if title and url:
                                        events.append((mtime, seq, title, url))
                                        seq += 1
            except Exception:
                pass

    def is_auth_callback_url(url):
        u = (url or "").lower()
        return any(tok in u for tok in (
            "/oidc/callback",
            "/oauth/callback",
            "/auth/callback",
            "auth.meta.com/",
            "accounts.google.com/signin",
            "accounts.google.com/servicelogin",
            "accounts.google.com/interactivelogin",
        ))

    # Prefer real destination pages over transient OAuth/OIDC callback redirects, then most recent.
    ranked_events = sorted(
        events,
        key=lambda item: (0 if is_auth_callback_url(item[3]) else 1, item[0], item[1]),
    )
    exact_map = {}
    norm_map = {}
    for ts, seq, title, url in ranked_events:
        rank = (0 if is_auth_callback_url(url) else 1, ts, seq)
        exact_map[title] = (rank, url)
        norm = re.sub(r"^\(\d+\)\s+", "", title)
        norm_map[norm] = (rank, url)
    return exact_map, norm_map


def resolve_browser_url(title, exact_map, norm_map):
    if not title:
        return ""
    clean = title
    for suffix in (" - Chromium", " - Google Chrome", " - Brave Browser", " - Brave"):
        if clean.endswith(suffix):
            clean = clean[: -len(suffix)]
            break
    norm = re.sub(r"^\(\d+\)\s+", "", clean)
    e_hit = exact_map.get(clean)
    n_hit = norm_map.get(norm)
    if e_hit and n_hit:
        return e_hit[1] if e_hit[0] >= n_hit[0] else n_hit[1]
    if e_hit:
        return e_hit[1]
    if n_hit:
        return n_hit[1]
    return ""


try:
    raw = subprocess.check_output(["hyprctl", "clients", "-j"])
    clients = json.loads(raw)
    has_browser = any(
        any(b in (c.get("class") or "").lower() for b in ("chromium", "chrome", "brave"))
        for c in clients
    )
    exact_urls, norm_urls = get_chromium_title_url_maps() if has_browser else ({}, {})
    for c in clients:
        cls = (c.get("class") or "").lower()
        if any(b in cls for b in ("chromium", "chrome", "brave")):
            url = resolve_browser_url(c.get("title") or "", exact_urls, norm_urls)
            if url:
                c["browserUrl"] = url
                c["browserHost"] = (urllib.parse.urlparse(url).hostname or "").lower()
        if "stremio" in cls:
            names = get_stremio_active_names()
            if names:
                c["title"] = f"{c.get('title') or 'Stremio'} - {', '.join(names)}"
        if any(term in cls for term in ("kitty", "terminal", "alacritty", "foot", "wezterm", "xterm")):
            pid = c.get("pid")
            if pid:
                is_colgate = get_terminal_colgate_context(pid)
                if is_colgate:
                    c["isColgate"] = True
                fg = get_foreground_process(pid)
                if fg:
                    c["processName"] = fg
                    current_title = c.get("title") or ""
                    if fg not in current_title.lower():
                        c["title"] = f"{fg} - {current_title}" if current_title else fg
                else:
                    if is_colgate:
                        c["processName"] = "colgate"
                    elif get_terminal_git_context(pid):
                        c["processName"] = "git"
                        c["isGitRepo"] = True
    print(json.dumps(clients))
except Exception:
    subprocess.run(["hyprctl", "clients", "-j"])
