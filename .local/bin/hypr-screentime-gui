  <script>
    const data = {data_json};

    function renderDonutAndCategories() {{
      const svg = document.getElementById("donutSvg");
      const list = document.getElementById("catList");
      svg.innerHTML = "";
      list.innerHTML = "";

      const cats = data.categories || [];
      const total = data.total_seconds || 0;

      if (cats.length === 0 || total === 0) {{
        svg.innerHTML = '<circle cx="21" cy="21" r="15.915" fill="transparent" stroke="rgba(255,255,255,0.08)" stroke-width="5"></circle>';
        list.innerHTML = '<div style="color: #71717a; font-size: 12px;">No recorded activity for this period.</div>';
        return;
      }}

      let offset = 0;
      cats.forEach(c => {{
        const pct = c.percentage;
        const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        circle.setAttribute("cx", "21");
        circle.setAttribute("cy", "21");
        circle.setAttribute("r", "15.91549430918954");
        circle.setAttribute("fill", "transparent");
        circle.setAttribute("stroke", c.color);
        circle.setAttribute("stroke-width", "5");
        circle.setAttribute("stroke-dasharray", `${{pct}} ${{100 - pct}}`);
        circle.setAttribute("stroke-dashoffset", -offset);
        svg.appendChild(circle);
        offset += pct;

        const row = document.createElement("div");
        row.className = "cat-item";
        row.innerHTML = `
          <div class="cat-head">
            <div class="cat-label">
              <span class="dot" style="background: ${{c.color}};"></span>
              <span>${{c.name}}</span>
            </div>
            <div class="cat-meta">
              <span class="cat-dur">${{c.formatted}}</span>
              <span class="cat-pct">${{c.percentage}}%</span>
            </div>
          </div>
          <div class="progress-track">
            <div class="progress-fill" style="width: ${{c.percentage}}%; background: ${{c.color}};"></div>
          </div>
        `;
        list.appendChild(row);
      }});
    }}

    function renderMedia() {{
      const mediaBox = document.getElementById("currentMediaBox");
      const tracksList = document.getElementById("tracksList");
      mediaBox.innerHTML = "";
      tracksList.innerHTML = "";

      if (data.current_media && data.current_media.is_playing) {{
        const cm = data.current_media;
        mediaBox.innerHTML = `
          <div class="live-badge">
            <span class="live-dot"></span>
            <span>Now Playing: ${{escapeHtml(cm.title)}}${{cm.artist ? ' — ' + escapeHtml(cm.artist) : ''}} (${{cm.player}})</span>
          </div>
        `;
      }}

      const tracks = data.background_tracks || [];
      if (tracks.length === 0) {{
        tracksList.innerHTML = '<div style="color: #71717a; font-size: 12px; padding: 6px 0;">No background audio detected for this period.</div>';
        return;
      }}

      tracks.forEach(t => {{
        const item = document.createElement("div");
        item.className = "track-item";
        item.innerHTML = `
          <div class="track-info">
            <span class="track-title" title="${{escapeHtml(t.title)}}">${{escapeHtml(t.title)}}</span>
            <span class="track-artist">${{t.artist ? escapeHtml(t.artist) : 'Audio / Media'}}</span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="player-tag">${{t.player}}</span>
            <span style="font-weight: 600; color: #ffffff; font-size: 12px;">${{t.formatted}}</span>
          </div>
        `;
        tracksList.appendChild(item);
      }});
    }}

    function renderApps() {{
      const list = document.getElementById("appsList");
      list.innerHTML = "";

      const apps = data.top_apps || [];
      if (apps.length === 0) {{
        list.innerHTML = '<div style="color: #71717a; font-size: 12px;">No applications tracked yet.</div>';
        return;
      }}

      apps.forEach(app => {{
        const item = document.createElement("div");
        item.className = "app-card-detailed";

        let actHtml = "";
        if (app.activities && app.activities.length > 0) {{
          actHtml = '<div class="app-activities-list">';
          app.activities.forEach(act => {{
            actHtml += `<span class="act-tag" title="${{escapeHtml(act)}}">${{escapeHtml(act)}}</span>`;
          }});
          actHtml += '</div>';
        }}

        item.innerHTML = `
          <div class="app-main-row">
            <div class="app-name-wrap">
              <span class="dot" style="background: ${{app.color}};"></span>
              <span class="app-name">${{escapeHtml(app.display_name)}}</span>
              <span class="app-cat-badge">${{escapeHtml(app.category)}}</span>
            </div>
            <div class="app-dur" style="color: ${{app.color}};">${{app.formatted}}</div>
          </div>
          <div class="progress-track">
            <div class="progress-fill" style="width: ${{app.percentage}}%; background: ${{app.color}};"></div>
          </div>
          ${{actHtml}}
        `;
        list.appendChild(item);
      }});
    }}

    function renderWindows() {{
      const tbody = document.getElementById("windowsTable");
      tbody.innerHTML = "";

      const windows = data.top_windows || [];
      if (windows.length === 0) {{
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #71717a; padding: 18px;">No window events logged yet.</td></tr>';
        return;
      }}

      windows.forEach(w => {{
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td style="font-weight: 600;">${{escapeHtml(w.app)}}</td>
          <td class="col-title" title="${{escapeHtml(w.title)}}">${{escapeHtml(w.title)}}</td>
          <td><span class="pill" style="background: ${{w.color}}22; color: ${{w.color}};">${{escapeHtml(w.category)}}</span></td>
          <td style="font-weight: 600;">${{w.formatted}}</td>
          <td style="color: #71717a;">${{w.percentage}}%</td>
        `;
        tbody.appendChild(tr);
      }});
    }}

    function escapeHtml(text) {{
      if (!text) return "";
      return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }}

    function switchPeriod(p) {{
      window.location.href = "screentime://period/" + p;
    }}

    function refreshData() {{
      window.location.href = "screentime://refresh";
    }}

    function openRules() {{
      window.location.href = "screentime://open-rules";
    }}

    renderDonutAndCategories();
    renderMedia();
    renderApps();
    renderWindows();
  </script>
</body>
</html>
"""


class ScreenTimeWindow(Gtk.Window):
    def __init__(self, period="today"):
        super().__init__(title="Screen Time")
        self.set_default_size(1060, 780)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_role("hypr-screentime-gui")

        self.period = period
        self.webview = WebKit2.WebView()

        bg_color = Gdk.RGBA(0.05, 0.05, 0.07, 0.98)
        self.webview.set_background_color(bg_color)

        self.webview.connect("decide-policy", self.on_decide_policy)
        self.add(self.webview)

        self.load_dashboard()

    def load_dashboard(self):
        data = get_data(self.period)
        html = generate_html(data)
        self.webview.load_html(html, "http://localhost")

    def on_decide_policy(self, webview, decision, decision_type):
        if decision_type == WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            nav_action = decision.get_navigation_action()
            uri = nav_action.get_request().get_uri()

            if uri.startswith("screentime://"):
                decision.ignore()
                cmd = uri[len("screentime://"):]
                if cmd.startswith("period/"):
                    self.period = cmd.split("/")[1]
                    self.load_dashboard()
                elif cmd == "refresh":
                    self.load_dashboard()
                elif cmd == "open-rules":
                    subprocess.Popen(["xdg-open", str(RULES_FILE)])
                return True
        return False


def main():
    period = "today"
    if len(sys.argv) > 1 and sys.argv[1] in ("week", "today"):
        period = sys.argv[1]

    win = ScreenTimeWindow(period)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
