#!/usr/bin/env python3
"""
hypr-screentime-gui: Modern, Obsidian-frosted dashboard for screen time analytics.
Uses PyGObject (GTK3) + WebKit2 for hardware-accelerated rendering.
Features dedicated graphs for each metric, pure English labels, zero emojis.
"""

import sys
import os
import json
import sqlite3
from pathlib import Path
from datetime import datetime, date, timedelta

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('WebKit2', '4.1')
from gi.repository import Gtk, WebKit2, Gdk

HOME = Path.home()
DATA_DIR = HOME / ".local" / "share" / "hypr-screentime"
CONFIG_DIR = HOME / ".config" / "hypr-screentime"
DB_FILE = DATA_DIR / "screentime.db"
RULES_FILE = CONFIG_DIR / "rules.json"


def format_duration(seconds: int) -> str:
    if seconds < 60:
        return f"{seconds}s"
    minutes = seconds // 60
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    rem_min = minutes % 60
    if rem_min == 0:
        return f"{hours}h"
    return f"{hours}h {rem_min:02d}m"


def get_data(period="today"):
    if not DB_FILE.exists():
        return {"total_seconds": 0, "categories": {}, "top_apps": [], "top_windows": []}

    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()

    today_str = date.today().isoformat()
    if period == "today":
        date_clause = "date = ?"
        params = (today_str,)
    else:
        week_ago = (date.today() - timedelta(days=6)).isoformat()
        date_clause = "date >= ?"
        params = (week_ago,)

    c.execute(f"SELECT SUM(duration) FROM sessions WHERE {date_clause}", params)
    total_sec = c.fetchone()[0] or 0

    c.execute(f"""
        SELECT category, SUM(duration) as dur
        FROM sessions
        WHERE {date_clause}
        GROUP BY category
        ORDER BY dur DESC
    """, params)
    cat_rows = c.fetchall()

    cat_meta = {
        "Work & Dev": {"color": "#30d158", "icon": "󰌢"},
        "Leisure & Slacking": {"color": "#ff453a", "icon": "󰊗"},
        "Terminal": {"color": "#6fbf27", "icon": "󰆍"},
        "Communication": {"color": "#bf5af2", "icon": "󰭹"},
        "Media & Audio": {"color": "#ff9f0a", "icon": "󰎈"},
        "Other": {"color": "#71717a", "icon": "󰘓"}
    }
    if RULES_FILE.exists():
        try:
            with open(RULES_FILE, "r", encoding="utf-8") as f:
                r_json = json.load(f)
                for cat in r_json.get("categories", []):
                    cat_meta[cat["name"]] = {"color": cat.get("color", "#a1a1aa"), "icon": cat.get("icon", "󰘓")}
        except Exception:
            pass

    categories = []
    for cat_name, dur in cat_rows:
        pct = round((dur / total_sec * 100), 1) if total_sec > 0 else 0
        meta = cat_meta.get(cat_name, {"color": "#a1a1aa", "icon": "󰘓"})
        categories.append({
            "name": cat_name,
            "seconds": dur,
            "formatted": format_duration(dur),
            "percentage": pct,
            "color": meta["color"],
            "icon": meta["icon"]
        })

    c.execute(f"""
        SELECT app_class, category, SUM(duration) as dur
        FROM sessions
        WHERE {date_clause} AND app_class != ''
        GROUP BY app_class
        ORDER BY dur DESC
        LIMIT 8
    """, params)
    top_apps = []
    for app, cat_name, dur in c.fetchall():
        pct = round((dur / total_sec * 100), 1) if total_sec > 0 else 0
        meta = cat_meta.get(cat_name, {"color": "#a1a1aa", "icon": "󰘓"})
        top_apps.append({
            "class": app,
            "category": cat_name,
            "seconds": dur,
            "formatted": format_duration(dur),
            "percentage": pct,
            "color": meta["color"]
        })

    c.execute(f"""
        SELECT app_class, window_title, category, SUM(duration) as dur
        FROM sessions
        WHERE {date_clause} AND app_class != ''
        GROUP BY app_class, window_title
        ORDER BY dur DESC
        LIMIT 30
    """, params)
    top_windows = []
    for app, title, cat_name, dur in c.fetchall():
        pct = round((dur / total_sec * 100), 1) if total_sec > 0 else 0
        meta = cat_meta.get(cat_name, {"color": "#a1a1aa", "icon": "󰘓"})
        top_windows.append({
            "class": app,
            "title": title if title else "(No Title)",
            "category": cat_name,
            "seconds": dur,
            "formatted": format_duration(dur),
            "percentage": pct,
            "color": meta["color"]
        })

    conn.close()

    work_dur = sum(c["seconds"] for c in categories if c["name"] in ("Work & Dev", "Terminal", "Trabajo"))
    slacking_dur = sum(c["seconds"] for c in categories if c["name"] in ("Leisure & Slacking", "Hacerse Wey"))
    focus_sum = work_dur + slacking_dur
    prod_score = round((work_dur / focus_sum * 100)) if focus_sum > 0 else 100

    work_pct = round((work_dur / total_sec * 100), 1) if total_sec > 0 else 0
    slacking_pct = round((slacking_dur / total_sec * 100), 1) if total_sec > 0 else 0

    return {
        "period": period,
        "date_label": "Today (" + today_str + ")" if period == "today" else "Last 7 Days",
        "total_seconds": total_sec,
        "total_formatted": format_duration(total_sec),
        "work_formatted": format_duration(work_dur),
        "work_seconds": work_dur,
        "work_pct": work_pct,
        "slacking_formatted": format_duration(slacking_dur),
        "slacking_seconds": slacking_dur,
        "slacking_pct": slacking_pct,
        "productivity_score": prod_score,
        "categories": categories,
        "top_apps": top_apps,
        "top_windows": top_windows
    }


