#!/usr/bin/env python3
"""
hypr-screentime-gui: Modern, minimalist screen time analytics dashboard.
Uses PyGObject (GTK3) + WebKit2 for hardware-accelerated rendering.
Features clean Apple-style typography, zero nerd font icons, dedicated background audio tracking,
and detailed per-app subactivities. Everything in pure, clean English.
"""

