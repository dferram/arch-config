    "antigravity ide": "Antigravity IDE",
    "mpv": "MPV",
    "vlc": "VLC",
    "org.gnome.nautilus": "Files",
    "dolphin": "Dolphin"
}

IGNORE_CLASSES = {
    "hyprland-dialog",
    "hypr-screentime-gui",
    "xdg-desktop-portal-gtk",
    "xdg-desktop-portal-hyprland",
    "zenity",
    "polkit-gnome-authentication-agent-1",
    "org.kde.polkit-kde-authentication-agent-1"
}


def normalize_title(title: str) -> str:
    if not title:
        return ""
    # Strip notification badge counters: (13), (99+), [2]
    return re.sub(r'^\s*[\(\[]\d+\+?[\)\]]\s*', '', title).strip()


def clean_display_title(title: str) -> str:
    if not title:
        return ""
    t = normalize_title(title)
    # Strip common browser trailing suffixes
    return re.sub(r'\s*[-—]\s*(?:Chromium|Google Chrome|Mozilla Firefox|Zen Browser|Brave)$', '', t).strip()


def format_duration(seconds: int) -> str:
    if seconds < 60:
        return f"{seconds}s"
    minutes = seconds // 60
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    rem_min = minutes % 60
    if rem_min == 0:
        return f"{hours}h"
    return f"{hours}h {rem_min:02d}m"


def get_current_media():
    try:
        res = subprocess.run(
            ["playerctl", "-a", "metadata", "--format", "{{playerName}}\t{{status}}\t{{title}}\t{{artist}}"],
            capture_output=True, text=True, timeout=1.0
        )
        for line in res.stdout.strip().split("\n"):
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1].strip() == "Playing":
                raw_player = parts[0].strip()
                title = parts[2].strip() if len(parts) > 2 else ""
                artist = parts[3].strip() if len(parts) > 3 else ""
                player_clean = "Spotify" if "spotify" in raw_player.lower() else ("YouTube / Web" if "chromium" in raw_player.lower() or "firefox" in raw_player.lower() else raw_player.capitalize())
                return {
                    "player": player_clean,
                    "title": title or "Playing",
                    "artist": artist,
                    "is_playing": True
                }
    except Exception:
        pass
    return None


def get_data(period="today"):
    if not DB_FILE.exists():
        return {
            "period": period,
            "date_label": "Today",
            "total_seconds": 0,
            "total_formatted": "0s",
            "work_formatted": "0s",
            "work_pct": 0,
            "ent_formatted": "0s",
            "ent_pct": 0,
            "bg_formatted": "0s",
            "bg_seconds": 0,
            "productivity_score": 100,
            "categories": [],
            "top_apps": [],
            "top_windows": [],
            "background_tracks": [],
            "current_media": None
        }

    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()

    today = date.today()
    today_str = today.isoformat()
    if period == "today":
        date_clause = "date = ?"
        params = (today_str,)
        date_label = f"Today ({today.strftime('%b %d, %Y')})"
    else:
        week_ago = (today - timedelta(days=6)).isoformat()
        date_clause = "date >= ?"
        params = (week_ago,)
        date_label = "Last 7 Days"

    c.execute(f"SELECT SUM(duration) FROM sessions WHERE {date_clause} AND category != 'Idle' AND app_class != ''", params)
    total_sec = c.fetchone()[0] or 0

    c.execute(f"""
        SELECT category, SUM(duration) as dur
        FROM sessions
        WHERE {date_clause} AND category != 'Idle' AND app_class != ''
        GROUP BY category
        ORDER BY dur DESC
    """, params)
    cat_rows = c.fetchall()

    cat_colors = {
        "Work & Dev": "#30d158",
        "Entertainment": "#ff453a",
        "Communication": "#bf5af2",
        "Music & Audio": "#ff9f0a",
        "Terminal": "#6fbf27",
        "Web Browsing": "#0a84ff",
        "Other Apps": "#71717a"
    }
    if RULES_FILE.exists():
        try:
            with open(RULES_FILE, "r", encoding="utf-8") as f:
                r_json = json.load(f)
                for cat in r_json.get("categories", []):
                    cat_colors[cat["name"]] = cat.get("color", "#a1a1aa")
                def_cat = r_json.get("default_category", {})
                if def_cat.get("name"):
                    cat_colors[def_cat["name"]] = def_cat.get("color", "#71717a")
        except Exception:
            pass

    categories = []
    for cat_name, dur in cat_rows:
        if cat_name == "Idle":
            continue
        pct = round((dur / total_sec * 100), 1) if total_sec > 0 else 0
        categories.append({
            "name": cat_name,
            "seconds": dur,
            "formatted": format_duration(dur),
            "percentage": pct,
            "color": cat_colors.get(cat_name, "#a1a1aa")
        })

    # Top Applications (with detailed sub-activities)
    ignore_lower = [cls.lower() for cls in IGNORE_CLASSES]
    placeholders = ",".join("?" for _ in ignore_lower)

    c.execute(f"""
        SELECT LOWER(app_class) as clean_app, SUM(duration) as dur
        FROM sessions
        WHERE {date_clause} AND app_class != '' AND LOWER(app_class) NOT IN ({placeholders})
        GROUP BY LOWER(app_class)
        ORDER BY dur DESC
        LIMIT 6
    """, (*params, *ignore_lower))
    top_apps_raw = c.fetchall()

    top_apps = []
    for app_lower, dur in top_apps_raw:
        pct = round((dur / total_sec * 100), 1) if total_sec > 0 else 0

        c.execute(f"""
            SELECT category, SUM(duration) as cat_dur
            FROM sessions
            WHERE {date_clause} AND LOWER(app_class) = ?
            GROUP BY category
            ORDER BY cat_dur DESC
            LIMIT 1
        """, (*params, app_lower))
        dom = c.fetchone()
        cat_name = dom[0] if dom else "Other Apps"
        app_color = cat_colors.get(cat_name, "#a1a1aa")

        # Sub-activities (window tabs, projects, commands)
        c.execute(f"""
            SELECT window_title, SUM(duration) as win_dur
            FROM sessions
            WHERE {date_clause} AND LOWER(app_class) = ? AND window_title != ''
            GROUP BY window_title
            ORDER BY win_dur DESC
            LIMIT 10
        """, (*params, app_lower))

        seen_acts = set()
        activities = []
        for r in c.fetchall():
            clean_t = clean_display_title(r[0])
            if clean_t and clean_t.lower() not in seen_acts and clean_t.lower() != app_lower:
                seen_acts.add(clean_t.lower())
                activities.append(clean_t)
            if len(activities) >= 3:
                break

        display_name = APP_NAME_MAP.get(app_lower, app_lower.capitalize())

        top_apps.append({
            "class": app_lower,
            "display_name": display_name,
            "category": cat_name,
            "seconds": dur,
            "formatted": format_duration(dur),
            "percentage": pct,
            "color": app_color,
            "activities": activities
        })

    # Background Audio tracking (Spotify, YouTube, etc.)
    c.execute(f"""
        SELECT SUM(duration)
        FROM background_media
        WHERE {date_clause}
    """, params)
    bg_total_sec = c.fetchone()[0] or 0

    c.execute(f"""
        SELECT player, title, artist, SUM(duration) as dur
        FROM background_media
        WHERE {date_clause}
        GROUP BY player, title
        ORDER BY dur DESC
        LIMIT 6
    """, params)
    bg_rows = c.fetchall()

    background_tracks = []
    for player, title, artist, dur in bg_rows:
        p_clean = "Spotify" if "spotify" in player.lower() else ("YouTube / Web" if "chromium" in player.lower() or "firefox" in player.lower() else player.capitalize())
        background_tracks.append({
            "player": p_clean,
            "title": title or "Unknown Track",
            "artist": artist or "",
            "seconds": dur,
            "formatted": format_duration(dur)
        })

    # Window Breakdown Table (grouped & deduplicated)
    c.execute(f"""
        SELECT LOWER(app_class) as clean_app, window_title, category, SUM(duration) as dur
        FROM sessions
        WHERE {date_clause} AND app_class != '' AND LOWER(app_class) NOT IN ({placeholders}) AND window_title != ''
        GROUP BY LOWER(app_class), window_title
        ORDER BY dur DESC
        LIMIT 60
    """, (*params, *ignore_lower))

    title_group = {}
    for app_lower, raw_title, cat_name, dur in c.fetchall():
        clean_t = clean_display_title(raw_title)
        if not clean_t:
            continue
        key = (app_lower, clean_t, cat_name)
        title_group[key] = title_group.get(key, 0) + dur

    sorted_windows = sorted(title_group.items(), key=lambda x: x[1], reverse=True)[:30]
    top_windows = []
    for (app_lower, clean_t, cat_name), dur in sorted_windows:
        pct = round((dur / total_sec * 100), 1) if total_sec > 0 else 0
        top_windows.append({
            "app": APP_NAME_MAP.get(app_lower, app_lower.capitalize()),
            "title": clean_t,
            "category": cat_name,
            "seconds": dur,
            "formatted": format_duration(dur),
            "percentage": pct,
            "color": cat_colors.get(cat_name, "#a1a1aa")
        })

    conn.close()

    work_dur = sum(c["seconds"] for c in categories if c["name"] in ("Work & Dev", "Terminal", "Trabajo y Desarrollo"))
    ent_dur = sum(c["seconds"] for c in categories if c["name"] in ("Entertainment", "Entretenimiento"))
    focus_sum = work_dur + ent_dur
    prod_score = round((work_dur / focus_sum * 100)) if focus_sum > 0 else 100

    work_pct = round((work_dur / total_sec * 100), 1) if total_sec > 0 else 0
    ent_pct = round((ent_dur / total_sec * 100), 1) if total_sec > 0 else 0

    return {
        "period": period,
        "date_label": date_label,
        "total_seconds": total_sec,
        "total_formatted": format_duration(total_sec),
        "work_formatted": format_duration(work_dur),
        "work_pct": work_pct,
        "ent_formatted": format_duration(ent_dur),
        "ent_pct": ent_pct,
        "bg_formatted": format_duration(bg_total_sec),
        "bg_seconds": bg_total_sec,
        "productivity_score": prod_score,
        "categories": categories,
        "top_apps": top_apps,
        "top_windows": top_windows,
        "background_tracks": background_tracks,
        "current_media": get_current_media()
    }


