  <script>
    const serverData = {data_json};

    function renderDonutAndBars(categories, totalSec) {{
      const svg = document.getElementById("donutSvg");
      const bars = document.getElementById("categoryBars");
      svg.innerHTML = "";
      bars.innerHTML = "";

      if (!categories || categories.length === 0 || totalSec === 0) {{
        svg.innerHTML = '<circle cx="21" cy="21" r="15.915" fill="transparent" stroke="#22222a" stroke-width="5"></circle>';
        bars.innerHTML = '<div style="color: #71717a; font-size: 13px;">No session data recorded yet for this period.</div>';
        return;
      }}

      let currentOffset = 0;
      categories.forEach(cat => {{
        const pct = cat.percentage;
        const strokeDash = `${{pct}} ${{100 - pct}}`;
        const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        circle.setAttribute("cx", "21");
        circle.setAttribute("cy", "21");
        circle.setAttribute("r", "15.91549430918954");
        circle.setAttribute("fill", "transparent");
        circle.setAttribute("stroke", cat.color);
        circle.setAttribute("stroke-width", "5.5");
        circle.setAttribute("stroke-dasharray", strokeDash);
        circle.setAttribute("stroke-dashoffset", -currentOffset);
        svg.appendChild(circle);
        currentOffset += pct;

        // Progress bar for each category
        const item = document.createElement("div");
        item.className = "cat-bar-item";
        item.innerHTML = `
          <div class="cat-bar-header">
            <div class="cat-bar-left">
              <span>${{cat.icon}}</span>
              <span>${{cat.name}}</span>
            </div>
            <div class="cat-bar-right">
              <span class="cat-bar-dur">${{cat.formatted}}</span>
              <span class="cat-bar-pct">${{cat.percentage}}%</span>
            </div>
          </div>
          <div class="cat-bar-track">
            <div class="cat-bar-inner" style="width: ${{cat.percentage}}%; background: ${{cat.color}};"></div>
          </div>
        `;
        bars.appendChild(item);
      }});
    }}

    function renderApps(apps) {{
      const appList = document.getElementById("appList");
      appList.innerHTML = "";

      if (!apps || apps.length === 0) {{
        appList.innerHTML = '<div style="color: #71717a; font-size: 13px;">No applications tracked yet.</div>';
        return;
      }}

      apps.forEach(app => {{
        const item = document.createElement("div");
        item.className = "app-item";
        item.innerHTML = `
          <div class="app-top">
            <div class="app-class">${{app.class}}</div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="app-cat">${{app.category}}</span>
              <span style="font-weight: 600; font-size: 13px; color: ${{app.color}};">${{app.formatted}}</span>
            </div>
          </div>
          <div class="app-track">
            <div class="app-fill" style="width: ${{app.percentage}}%; background: ${{app.color}};"></div>
          </div>
        `;
        appList.appendChild(item);
      }});
    }}

    function renderWindows(windows) {{
      const tbody = document.getElementById("windowsTableBody");
      tbody.innerHTML = "";

      if (!windows || windows.length === 0) {{
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #71717a; padding: 20px;">No window events logged yet.</td></tr>';
        return;
      }}

      windows.forEach(w => {{
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td style="font-weight: 600;">${{w.class}}</td>
          <td class="col-title" title="${{w.title.replace(/"/g, '&quot;')}}">${{w.title}}</td>
          <td><span class="pill" style="background: ${{w.color}}22; color: ${{w.color}};">${{w.category}}</span></td>
          <td style="font-weight: 600;">${{w.formatted}}</td>
          <td style="color: #71717a;">${{w.percentage}}%</td>
        `;
        tbody.appendChild(tr);
      }});
    }}

    function switchPeriod(p) {{
      window.location.href = "screentime://period/" + p;
    }}

    function refreshData() {{
      window.location.href = "screentime://refresh";
    }}

    function openRules() {{
      window.location.href = "screentime://open-rules";
    }}

    renderDonutAndBars(serverData.categories, serverData.total_seconds);
    renderApps(serverData.top_apps);
    renderWindows(serverData.top_windows);
  </script>
</body>
</html>
"""


class ScreenTimeWindow(Gtk.Window):
    def __init__(self, period="today"):
        super().__init__(title="Screen Time Analytics")
        self.set_default_size(980, 680)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_role("hypr-screentime-gui")

        self.period = period
        self.webview = WebKit2.WebView()

        bg_color = Gdk.RGBA(0.04, 0.04, 0.06, 0.98)
        self.webview.set_background_color(bg_color)

        self.webview.connect("decide-policy", self.on_decide_policy)
        self.add(self.webview)

        self.load_dashboard()

    def load_dashboard(self):
        data = get_data(self.period)
        html = generate_html(data)
        self.webview.load_html(html, "http://localhost")

    def on_decide_policy(self, webview, decision, decision_type):
        if decision_type == WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            nav_action = decision.get_navigation_action()
            uri = nav_action.get_request().get_uri()

            if uri.startswith("screentime://"):
                decision.ignore()
                cmd = uri[len("screentime://"):]
                if cmd.startswith("period/"):
                    self.period = cmd.split("/")[1]
                    self.load_dashboard()
                elif cmd == "refresh":
                    self.load_dashboard()
                elif cmd == "open-rules":
                    import subprocess
                    subprocess.Popen(["xdg-open", str(RULES_FILE)])
                return True
        return False


def main():
    period = "today"
    if len(sys.argv) > 1 and sys.argv[1] in ("week", "today"):
        period = sys.argv[1]

    win = ScreenTimeWindow(period)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
