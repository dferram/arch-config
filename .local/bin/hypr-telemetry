#!/usr/bin/env python3
import json
import os
import subprocess

def get_telemetry():
    kernel = os.uname().release
    
    # Uptime format: e.g. 23h 40m
    try:
        raw_up = subprocess.check_output(['uptime', '-p']).decode().strip().replace('up ', '')
        up_parts = raw_up.replace(' hours', 'h').replace(' hour', 'h').replace(' minutes', 'm').replace(' minute', 'm').replace(' days', 'd').replace(' day', 'd').split(', ')
        uptime = ' '.join(up_parts)
    except Exception:
        uptime = "Active"

    # Pacman packages
    try:
        pkgs = subprocess.check_output(['bash', '-c', 'pacman -Q | wc -l']).decode().strip()
    except Exception:
        pkgs = "Pacman"

    # CPU Model
    cpu = "Intel Core Ultra"
    try:
        with open('/proc/cpuinfo') as f:
            for line in f:
                if 'model name' in line:
                    c = line.split(':')[1].strip()
                    c = c.replace('Intel(R) Core(TM) ', '').replace('Intel(R) ', '').replace('AMD Ryzen ', 'Ryzen ')
                    c = c.split(' @ ')[0].strip()
                    cpu = c
                    break
    except Exception:
        pass

    # RAM
    ram = "15.1 GB"
    try:
        with open('/proc/meminfo') as f:
            mem = {}
            for line in f:
                p = line.split(':')
                mem[p[0].strip()] = int(p[1].split()[0])
            total = mem['MemTotal'] / (1024 * 1024)
            avail = mem['MemAvailable'] / (1024 * 1024)
            used = total - avail
            ram = f"{used:.1f} / {total:.1f} GB"
    except Exception:
        pass

    # Hostname & User
    user = os.environ.get("USER", "ferram")
    try:
        with open('/etc/hostname') as f:
            hostname = f.read().strip()
    except Exception:
        hostname = "ferram"

    return {
        "kernel": kernel,
        "uptime": uptime,
        "pkgs": f"{pkgs} pkgs",
        "cpu": cpu,
        "ram": ram,
        "host": "HUAWEI MateBook 14",
        "user": f"{user}@{hostname}",
        "wm": "Hyprland Wayland"
    }

if __name__ == "__main__":
    print(json.dumps(get_telemetry()))
