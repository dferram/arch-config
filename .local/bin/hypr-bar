#!/usr/bin/env python3
"""
hypr-bar:
Toggle or set the visibility of the Quickshell top status bar.
Communicates via Quickshell IPC (`qs ipc call bar ...`) and sends
a visual feedback notification.
"""

import sys
import subprocess
from pathlib import Path

STATE_FILE = Path.home() / ".local" / "state" / "hypr-bar"
ICON_PATH = "/home/ferram/.local/share/icons/arch.svg"

def query_ipc_visible() -> bool | None:
    try:
        res = subprocess.run(
            ["qs", "ipc", "call", "bar", "isVisible"],
            capture_output=True,
            text=True,
            timeout=2
        )
        if res.returncode == 0:
            return res.stdout.strip().lower() == "true"
    except Exception:
        pass
    return None

def is_bar_visible() -> bool:
    ipc_val = query_ipc_visible()
    if ipc_val is not None:
        return ipc_val
    if STATE_FILE.exists():
        try:
            return STATE_FILE.read_text().strip().lower() == "visible"
        except Exception:
            pass
    return True

def notify(visible: bool):
    title = "Desktop: Top Bar & Widgets" if visible else "Immersive Mode Active"
    msg = "Top bar and desktop widgets restored" if visible else "Top bar and desktop widgets hidden"
    try:
        subprocess.run([
            "notify-send", "-a", "Hyprland",
            "-i", ICON_PATH,
            "-t", "1200",
            "-h", "string:x-canonical-private-synchronous:topbar",
            "-h", "string:synchronous:topbar",
            "-h", f"boolean:active:{'true' if visible else 'false'}",
            title, msg
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def save_state(visible: bool):
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text("visible" if visible else "hidden")
    except Exception:
        pass

def set_bar(visible: bool):
    method = "open" if visible else "close"
    # Control top bar
    try:
        subprocess.run(["qs", "ipc", "call", "bar", method], check=True, timeout=2)
    except Exception:
        pass
    # Control desktop widgets
    try:
        subprocess.run(["qs", "ipc", "call", "widgets", method], check=True, timeout=2)
    except Exception:
        pass
    save_state(visible)
    notify(visible)

def toggle_bar():
    # Toggle based on current state so bar and widgets stay in sync
    new_state = not is_bar_visible()
    set_bar(new_state)

def main():
    arg = (sys.argv[1].lower() if len(sys.argv) > 1 else "toggle").strip()
    if arg in ["status", "-s", "--status"]:
        visible = is_bar_visible()
        print("visible" if visible else "hidden")
        sys.exit(0)
    elif arg in ["show", "on", "1", "true", "open"]:
        set_bar(True)
    elif arg in ["hide", "off", "0", "false", "close"]:
        set_bar(False)
    elif arg in ["toggle", "-t"]:
        toggle_bar()
    else:
        print("Usage: hypr-bar [status|show|hide|toggle]")
        sys.exit(1)

if __name__ == "__main__":
    main()
