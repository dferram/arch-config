#!/usr/bin/env bash
# hypr-clipboard:
# Clipboard manager integration using cliphist, wl-clipboard, and rofi.

ACTION="${1:-menu}"

case "$ACTION" in
    "menu"|"list"|"show")
        ITEM=$(cliphist list | rofi -dmenu -p "Clipboard" \
            -theme-str 'window {width: 50%; border: 1px; border-color: #e22b31; border-radius: 12px; background-color: #0b0f17fa; padding: 12px;} listview {lines: 10; spacing: 4px;} element {border-radius: 6px; padding: 6px 10px; text-color: #f1f5f9;} element selected {background-color: #331518; text-color: #ff787d; border: 1px; border-color: #e22b31;} inputbar {children: [prompt, entry]; text-color: #e22b31; margin: 0 0 10px 0;} entry {text-color: #f1f5f9;} prompt {text-color: #e22b31; font-weight: bold; margin: 0 8px 0 0;}')
        if [ -n "$ITEM" ]; then
            echo "$ITEM" | cliphist decode | wl-copy
            notify-send -a "Clipboard" -t 1500 "Copied to Clipboard" "Item copied and ready to paste."
        fi
        ;;
    "clear"|"wipe")
        cliphist wipe
        notify-send -a "Clipboard" -t 2000 "Clipboard Cleared" "All clipboard history has been wiped."
        ;;
    "daemon")
        pkill -f "cliphist store" 2>/dev/null || true
        wl-paste --type text --watch cliphist store &
        wl-paste --type image --watch cliphist store &
        ;;
    *)
        echo "Usage: hypr-clipboard [menu | clear | daemon]"
        exit 1
        ;;
esac
