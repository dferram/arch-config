def choose_wallpaper_menu():
    walls = sorted(get_wallpaper_list(), key=lambda x: x.name.lower())
    if not walls:
        return

    with ThreadPoolExecutor(max_workers=4) as pool:
        previews = list(pool.map(get_preview_path, walls))

    lines = "\n".join(
        f"{w.name}\0icon\x1f{preview}"
        for w, preview in zip(walls, previews)
    )

    rofi_cmd = [
        "rofi", "-dmenu", "-i", "-show-icons",
        "-no-custom", "-format", "i",
        "-p", "Wallpaper",
        "-theme-str", ROFI_MENU_THEME,
    ]

    cur_path = get_current_wallpaper()
    if cur_path is not None:
        for idx, w in enumerate(walls):
            if w.resolve() == cur_path:
                rofi_cmd.extend(["-selected-row", str(idx), "-a", str(idx)])
                break

    try:
        proc = subprocess.run(rofi_cmd, input=lines.encode(), stdout=subprocess.PIPE, check=True)
        selected = proc.stdout.decode().strip()
        if selected:
            apply_wallpaper(walls[int(selected)])
    except Exception:
        pass

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].strip()
        if arg in ["random", "rand", "-r"]:
            walls = get_wallpaper_list()
            if walls:
                cur_path = get_current_wallpaper()
                choices = [w for w in walls if w.resolve() != cur_path] or walls
                target = random.choice(choices)
                apply_wallpaper(target)
            return
        elif arg in ["menu", "select", "-m"]:
            choose_wallpaper_menu()
            return
        elif arg in ["list", "-l"]:
            for w in get_wallpaper_list():
                print(w)
            return
        else:
            target = Path(arg).expanduser()
    else:
        target = PICTURES_DIR / "spiderman.jpg"
        if not target.exists():
            target = HOME / "Pictures/wallpaper.png"

    apply_wallpaper(target)

if __name__ == "__main__":
    main()
