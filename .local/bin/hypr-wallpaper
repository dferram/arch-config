#!/usr/bin/env python3
"""
hypr-wallpaper: Dynamic Wallpaper & Liquid Glass Accent Theming for Hyprland + Quickshell
Extracts the dominant vibrant accent colors from any wallpaper and applies them
dynamically to Quickshell (bar & icons), Hyprland window borders, and Mako notifications,
while preserving the Apple-style Liquid Glass Obsidian frosted base 100% intact.
"""

import sys
import os
import subprocess
import colorsys
import re
import random
from pathlib import Path

HOME = Path.home()
THEME_QML = HOME / ".config/quickshell/theme/Theme.qml"
HYPRPAPER_CONF = HOME / ".config/hypr/hyprpaper.conf"
HYPRLAND_LUA = HOME / ".config/hypr/hyprland.lua"
MAKO_CONF = HOME / ".config/mako/config"
HYPRLOCK_CONF = HOME / ".config/hypr/hyprlock.conf"
KITTY_CONF = HOME / ".config/kitty/kitty.conf"
STARSHIP_CONF = HOME / ".config/starship.toml"
BASHRC = HOME / ".bashrc"
PICTURES_DIR = HOME / "Pictures"

def extract_vibrant_accent(image_path: Path):
    """
    Extracts the most representative vibrant accent color from the wallpaper.
    Samples pixels via ffmpeg downscaling and scores based on saturation, value, and frequency.
    """
    cmd = [
        "ffmpeg", "-y", "-v", "error", "-i", str(image_path),
        "-vf", "scale=150:150", "-vframes", "1",
        "-f", "image2pipe", "-vcodec", "ppm", "-"
    ]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    header = proc.stdout.readline()
    dims = proc.stdout.readline()
    while dims.startswith(b'#'):
        dims = proc.stdout.readline()
    w, h = map(int, dims.split())
    _ = proc.stdout.readline()
    raw_bytes = proc.stdout.read(w * h * 3)

    buckets = {}
    for i in range(0, len(raw_bytes), 3):
        r, g, b = raw_bytes[i], raw_bytes[i+1], raw_bytes[i+2]
        h_val, s_val, v_val = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)

        # Ignore nearly black, nearly white, or completely desaturated grays
        if v_val < 0.20 or v_val > 0.98 or s_val < 0.28:
            continue

        # Quantize hue into 24 bins (15 degrees each)
        bin_idx = int((h_val % 1.0) * 24)
        score = (s_val ** 1.5) * (v_val ** 1.2)

        if bin_idx not in buckets:
            buckets[bin_idx] = {"score": 0.0, "pixels": []}
        buckets[bin_idx]["score"] += score
        buckets[bin_idx]["pixels"].append((score, r, g, b, h_val, s_val, v_val))

    if not buckets:
        # Fallback to default vivid crimson
        return (255, 59, 48), (255, 105, 97), (183, 28, 28), (224, 108, 117)

    # Pick bucket with highest cumulative vibrant score
    best_bin = max(buckets.keys(), key=lambda k: buckets[k]["score"])
    best_pixels = buckets[best_bin]["pixels"]
    # Sort by individual pixel vibrancy
    best_pixels.sort(key=lambda p: p[0], reverse=True)
    top_p = best_pixels[0]

    h_base = top_p[4]
    s_base = max(0.65, min(0.95, top_p[5]))
    v_base = max(0.75, min(0.98, top_p[6]))

    # Derive primary accent
    r1, g1, b1 = [int(c * 255) for c in colorsys.hsv_to_rgb(h_base, s_base, v_base)]
    # Derive light accent (frost/highlight)
    r_light, g_light, b_light = [int(c * 255) for c in colorsys.hsv_to_rgb(h_base, max(0.40, s_base * 0.65), min(1.0, v_base * 1.15))]
    # Derive deep accent (active/focus)
    r_deep, g_deep, b_deep = [int(c * 255) for c in colorsys.hsv_to_rgb(h_base, min(1.0, s_base * 1.1), max(0.45, v_base * 0.60))]
    # Derive muted accent
    r_muted, g_muted, b_muted = [int(c * 255) for c in colorsys.hsv_to_rgb(h_base, max(0.35, s_base * 0.55), min(0.95, v_base * 0.95))]

    return (r1, g1, b1), (r_light, g_light, b_light), (r_deep, g_deep, b_deep), (r_muted, g_muted, b_muted)

def to_hex(rgb):
    return f"#{rgb[0]:02x}{rgb[1]:02x}{rgb[2]:02x}"

def apply_wallpaper(image_path: Path):
    if not image_path.exists():
        print(f"Error: File not found: {image_path}", file=sys.stderr)
        sys.exit(1)

    print(f"[*] Analyzing vibrant colors from: {image_path.name}")
    accent, light, deep, muted = extract_vibrant_accent(image_path)
    hex_acc = to_hex(accent)
    hex_light = to_hex(light)
    hex_deep = to_hex(deep)
    hex_muted = to_hex(muted)

    print(f"  -> Primary Accent: {hex_acc}")
    print(f"  -> Light Accent:   {hex_light}")
    print(f"  -> Deep Accent:    {hex_deep}")
    print(f"  -> Soft Accent:    {hex_muted}")

    # 1. Configure Hyprpaper (with persistent local copy to survive reboots/unmounted media)
    local_target = PICTURES_DIR / "Wallpapers" / image_path.name
    if image_path.resolve() != local_target.resolve():
        (PICTURES_DIR / "Wallpapers").mkdir(parents=True, exist_ok=True)
        import shutil
        shutil.copy2(image_path, local_target)
        image_path = local_target

    HYPRPAPER_CONF.parent.mkdir(parents=True, exist_ok=True)
    hyprpaper_content = f"""splash = false

wallpaper {{
    monitor =
    path = {image_path.resolve()}
}}
"""
    HYPRPAPER_CONF.write_text(hyprpaper_content)
    subprocess.run(["hyprctl", "hyprpaper", "wallpaper", f"eDP-1,{image_path.resolve()}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 2. Update Theme.qml keeping Liquid Glass obsidian base intact
    if THEME_QML.exists():
        qml_text = THEME_QML.read_text()
        palette_block = f"""    // Refined Accent Palette (Dynamic Wallpaper Accents)
    readonly property color blue: "{hex_acc}"       // Primary Dynamic Accent
    readonly property color blueLight: "{hex_light}"  // Highlights & Glow
    readonly property color blueDeep: "{hex_deep}"   // Deep State
    readonly property color blueMuted: "{hex_muted}"  // Soft Accent
    readonly property color cyan: "{hex_light}"       // Secondary Glow
    readonly property color frost: "#f1f5f9"      // Crystalline White
    readonly property color indigo: "{hex_deep}"     // Sub-accent
    readonly property color sky: blueLight
    readonly property color mauve: blue"""

        # Replace palette
        pattern = r"    // Refined (?:Apple Accent Palette|Accent Palette).*?\n    readonly property color mauve: blue"
        if re.search(pattern, qml_text, flags=re.DOTALL):
            new_qml = re.sub(pattern, palette_block, qml_text, flags=re.DOTALL)
            THEME_QML.write_text(new_qml)
            print("  [OK] Theme.qml updated (Liquid Glass 100% preserved)")

    # 3. Update window borders in Hyprland
    border_lua = f"hl.config({{ general = {{ col = {{ active_border = {{ colors = {{'rgba({hex_acc[1:]}ee)', 'rgba({hex_light[1:]}ee)'}}, angle = 45 }} }} }} }})"
    subprocess.run(["hyprctl", "eval", border_lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if HYPRLAND_LUA.exists():
        lua_text = HYPRLAND_LUA.read_text()
        lua_text = re.sub(
            r"(?<![a-zA-Z0-9_])active_border\s*=.*?\n",
            f"active_border   = {{ colors = {{'rgba({hex_acc[1:]}ee)', 'rgba({hex_light[1:]}ee)'}}, angle = 45 }},\n",
            lua_text
        )
        HYPRLAND_LUA.write_text(lua_text)
        print("  [OK] Hyprland borders updated")

    # 4. Update Mako
    if MAKO_CONF.exists():
        mako_text = MAKO_CONF.read_text()
        mako_text = re.sub(r"progress-color=over #[0-9a-fA-F]{6,8}", f"progress-color=over {hex_acc}66", mako_text)
        mako_text = re.sub(r"border-color=#[0-9a-fA-F]{6,8}", lambda m: f"border-color={hex_acc}cc" if ("38bdf8" in m.group(0) or "ff3b30" in m.group(0) or "ef4444" in m.group(0)) else m.group(0), mako_text)
        MAKO_CONF.write_text(mako_text)
        subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("  [OK] Mako notifications updated")

    # 5. Update Kitty terminal colors & reload
    if KITTY_CONF.exists():
        k_text = KITTY_CONF.read_text()
        k_text = re.sub(r"cursor\s+#[0-9a-fA-F]{6}", f"cursor               {hex_light}", k_text)
        k_text = re.sub(r"selection_background\s+#[0-9a-fA-F]{6}", f"selection_background {hex_acc}", k_text)
        k_text = re.sub(r"url_color\s+#[0-9a-fA-F]{6}", f"url_color            {hex_light}", k_text)
        k_text = re.sub(r"active_tab_background\s+#[0-9a-fA-F]{6}", f"active_tab_background   {hex_acc}", k_text)
        k_text = re.sub(r"color1\s+#[0-9a-fA-F]{6}", f"color1               {hex_acc}", k_text)
        k_text = re.sub(r"color9\s+#[0-9a-fA-F]{6}", f"color9               {hex_light}", k_text)
        KITTY_CONF.write_text(k_text)
        subprocess.run(["killall", "-SIGUSR1", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("  [OK] Kitty terminal theme synchronized")

    # 6. Update Starship prompt
    if STARSHIP_CONF.exists():
        s_text = STARSHIP_CONF.read_text()
        s_text = re.sub(r'success_symbol\s*=\s*"\\[\\$\]\(#[0-9a-fA-F]{6} bold\)"', f'success_symbol = "[\\\\$]({hex_acc} bold)"', s_text)
        s_text = re.sub(r'error_symbol\s*=\s*"\\[\\$\]\(#[0-9a-fA-F]{6} bold\)"', f'error_symbol = "[\\\\$]({hex_acc} bold)"', s_text)
        s_text = re.sub(r'style\s*=\s*"bold #[0-9a-fA-F]{6}"', f'style = "bold {hex_light}"', s_text, count=2)
        s_text = re.sub(r'\[git_status\]\s*\nstyle\s*=\s*"bold #[0-9a-fA-F]{6}"', f'[git_status]\nstyle = "bold {hex_acc}"', s_text)
        STARSHIP_CONF.write_text(s_text)
        print("  [OK] Starship prompt theme synchronized")

    # 7. Update FZF in ~/.bashrc
    if BASHRC.exists():
        b_text = BASHRC.read_text()
        b_text = re.sub(
            r'--color=bg\+:#18181b,bg:#0a0a0d,spinner:#[0-9a-fA-F]{6},hl:#[0-9a-fA-F]{6},fg:#e4e4e7,header:#71717a,info:#[0-9a-fA-F]{6},pointer:#[0-9a-fA-F]{6},marker:#[0-9a-fA-F]{6},fg\+:#ffffff,prompt:#[0-9a-fA-F]{6},hl\+:#[0-9a-fA-F]{6}',
            f'--color=bg+:#18181b,bg:#0a0a0d,spinner:{hex_light},hl:{hex_light},fg:#e4e4e7,header:#71717a,info:{hex_light},pointer:{hex_acc},marker:{hex_acc},fg+:#ffffff,prompt:{hex_acc},hl+:{hex_light}',
            b_text
        )
        BASHRC.write_text(b_text)

    # 8. Desktop notification
    try:
        subprocess.run([
            "notify-send", "-a", "Wallpaper",
            "-i", str(image_path),
            "-t", "2500",
            "Wallpaper Updated",
            f"{image_path.name}\nAccents synchronized ({hex_acc})."
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # 9. Restart Quickshell service to instantly reload the desktop bar
    subprocess.run(["systemctl", "--user", "restart", "quickshell.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("  [OK] Quickshell bar reloaded successfully!")

def get_wallpaper_list():
    wall_dir = PICTURES_DIR / "Wallpapers"
    candidates = []
    if wall_dir.exists():
        for ext in ["*.jpg", "*.jpeg", "*.png", "*.webp", "*.JPG", "*.PNG"]:
            candidates.extend(wall_dir.glob(ext))
    for ext in ["*.jpg", "*.jpeg", "*.png", "*.webp", "*.JPG", "*.PNG"]:
        candidates.extend(PICTURES_DIR.glob(ext))
    seen = set()
    unique = []
    for c in candidates:
        try:
            r = c.resolve()
            if r not in seen and c.is_file():
                seen.add(r)
                unique.append(c)
        except Exception:
            pass
    return unique

def choose_wallpaper_menu():
    walls = get_wallpaper_list()
    if not walls:
        return
    lines = "\n".join([w.name for w in sorted(walls, key=lambda x: x.name.lower())])
    rofi_cmd = [
        "rofi", "-dmenu", "-p", "Wallpaper",
        "-theme-str",
        "window {width: 35%; border: 1px; border-color: #262b3a; border-radius: 12px; background-color: #0c0e14f2; padding: 12px;} "
        "listview {lines: 8; spacing: 4px;} "
        "element {border-radius: 6px; padding: 8px 12px; text-color: #f1f5f9;} "
        "element selected {background-color: #1e2230; text-color: #ffffff; border: 1px; border-color: #e22b31;} "
        "inputbar {children: [prompt, entry]; text-color: #e22b31; margin: 0 0 10px 0;} "
        "entry {text-color: #f1f5f9;} "
        "prompt {text-color: #e22b31; font-weight: bold; margin: 0 8px 0 0;}"
    ]
    try:
        proc = subprocess.run(rofi_cmd, input=lines.encode(), stdout=subprocess.PIPE, check=True)
        selected_name = proc.stdout.decode().strip()
        if selected_name:
            for w in walls:
                if w.name == selected_name:
                    apply_wallpaper(w)
                    break
    except Exception:
        pass

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].strip()
        if arg in ["random", "rand", "-r"]:
            walls = get_wallpaper_list()
            if walls:
                cur_path = None
                if HYPRPAPER_CONF.exists():
                    m = re.search(r'path\s*=\s*([^\n]+)', HYPRPAPER_CONF.read_text())
                    if m:
                        cur_path = Path(m.group(1).strip()).resolve()
                choices = [w for w in walls if w.resolve() != cur_path] or walls
                target = random.choice(choices)
                apply_wallpaper(target)
            return
        elif arg in ["menu", "select", "-m"]:
            choose_wallpaper_menu()
            return
        elif arg in ["list", "-l"]:
            for w in get_wallpaper_list():
                print(w)
            return
        else:
            target = Path(arg).expanduser()
    else:
        target = PICTURES_DIR / "spiderman.jpg"
        if not target.exists():
            target = HOME / "Pictures/wallpaper.png"

    apply_wallpaper(target)

if __name__ == "__main__":
    main()
