#!/usr/bin/env python3
"""
cmds: Fast, color-coded cheatsheet for all custom tools, aliases, and shortcuts.
Usage:
    cmds          (Show all commands)
    cmds <query>  (Filter commands matching query)
"""

import sys

C_RESET  = "\033[0m"
C_BOLD   = "\033[1m"
C_DIM    = "\033[2m"
C_RED    = "\033[38;2;243;139;168m" # Soft red
C_RED_D  = "\033[38;2;230;69;83m"   # Darker red
C_ORANGE = "\033[38;2;250;179;135m" # Orange/Red
C_GRAY   = "\033[38;2;108;112;134m"
C_WHITE  = "\033[38;2;205;214;244m"

SECTIONS = [
    {
        "title": "BASH & TERMINAL NAVIGATION",
        "color": C_RED_D,
        "items": [
            ("z <dir>", "Zoxide: Instant jump to any directory (e.g. 'z hona')"),
            ("p", "Project Jump: Interactive fuzzy finder for projects"),
            ("Ctrl + R", "FZF History: Search and execute past commands"),
            ("Ctrl + T", "FZF Files: Search files in current folder"),
            ("v [file]", "Fuzzy Edit: Search & open file in Neovim (fzf+bat)"),
            ("vc [file]", "Fuzzy Code: Search & open file in Antigravity IDE"),
            ("rgf [query]", "Find in Code: Search text with ripgrep & open line"),
            ("fkill", "Kill Process: Interactive fuzzy process killer"),
            ("mkcd <dir>", "Make & Enter: Create folder and cd into it"),
            ("extract <f>", "Smart Extract: Unpack archive (.tar.gz, .zip)"),
            ("clip/paste", "Wayland Clipboard: Pipe output to/from clipboard"),
        ]
    },
    {
        "title": "HYPRLAND DESKTOP",
        "color": C_ORANGE,
        "items": [
            ("Super + H", "Quick Cheatsheet Floating Popup (any key to close)"),
            ("Super + Q", "Open Terminal (Kitty)"),
            ("Super + R", "App Launcher (Rofi/Wofi)"),
            ("Super + E", "Open File Manager"),
            ("Super + V", "Clipboard History Menu (wl-clip-persist)"),
            ("Super + C", "Close current active window"),
            ("Super + Space", "Toggle Floating Window"),
            ("Super + F", "Toggle Fullscreen Window"),
            ("Super + Tab", "Cycle forward between open windows"),
            ("Super + Arr", "Move focus to window (Left/Right/Up/Down)"),
            ("S+Shift+Arr", "Move window position (Left/Right/Up/Down)"),
            ("S+Alt+Arr", "Smoothly resize active window width and height"),
            ("Super + 1..9", "Switch to workspace 1-9"),
            ("S+Shift+1..9", "Move active window to workspace 1-9"),
            ("Super + º", "Toggle 'Magic' Scratchpad Workspace (hidden)"),
            ("S+Shift+º", "Send window to 'Magic' Scratchpad"),
            ("Super + B", "Open Btop Live Resource Monitor (floating)"),
            ("Print / F11", "Area screenshot (saved & copied to clipboard)"),
            ("Super + F10", "Toggle Warm Night Light (Hyprsunset)"),
        ]
    },
    {
        "title": "CHROMIUM & VIMIUM",
        "color": C_RED_D,
        "items": [
            ("f", "Vimium: Show keyboard hints on links (type to click)"),
            ("j / k", "Vimium: Scroll down / up smoothly"),
            ("J / K", "Vimium: Switch to left / right tab"),
            ("o", "Vimium: Open omnibar to search history/bookmarks"),
            ("x / X", "Vimium: Close current tab / Reopen last closed tab"),
            ("H / L", "Vimium: Go Back / Forward in browsing history"),
            ("Ctrl + L", "Focus URL Address bar (ready to type)"),
            ("Ctrl + T/W", "Open new tab / Close current active tab"),
            ("Ctrl+Shift+T", "Reopen last closed tab (undo tab close)"),
            ("Ctrl + Tab", "Switch to next tab in Chromium"),
        ]
    },
    {
        "title": "FULLSTACK DEVELOPER TOOLS",
        "color": C_ORANGE,
        "items": [
            ("top / htop", "Process Monitor: Interactive CPU/RAM dashboard"),
            ("loc [port]", "Open Localhost: Instant open localhost:<port>"),
            ("web <url>", "Web Search: Open URL or Google query in Chromium"),
            ("ports", "Ports: View active TCP ports, PIDs & commands"),
            ("killport", "Killport: Free blocked ports ('killport 3000')"),
            ("dev-db", "Dev-DB: Instant Docker databases ('dev-db up redis')"),
            ("ld", "Lazydocker: Real-time container dashboard & logs"),
            ("d", "Dust: Visual disk analyzer (find big node_modules)"),
            ("gh", "GitHub CLI: Manage PRs, issues, clones"),
            ("bun / pnpm", "Fastest JS runtime & Disk-saving Node package mgr"),
            ("uv", "Rust-powered Python package manager"),
            ("http", "HTTPie: Colorized human-friendly API testing"),
        ]
    },
    {
        "title": "SYSTEM & LAPTOP DIAGNOSTICS",
        "color": C_RED_D,
        "items": [
            ("lr", "Laptop Report: Live battery health, thermals & stats"),
            ("sudo powertop", "PowerTop: Process-by-process battery drain"),
            ("intel_gpu_top", "Intel Arc GPU load, render engines & wattage"),
            ("sudo ufw", "Check active firewall status & blocked connections"),
            ("sudo timeshift", "Create an immediate safety system restore point"),
            ("sysctl restart", "Restart audio engine (systemctl --user restart pipewire)"),
        ]
    }
]

ARCH_LOGO = f"""
{C_RED}      /\\      {C_BOLD}{C_RED_D}╭──────────────────────────────────────────╮
{C_RED}     /  \\     {C_BOLD}{C_RED_D}│  {C_BOLD}ARCH LINUX - TERMINAL CHEATSHEET{C_RED_D}        │
{C_RED}    /    \\    {C_BOLD}{C_RED_D}╰──────────────────────────────────────────╯
{C_RED}   /      \\   
{C_RED}  /   ,,   \\  
{C_RED} /   |  |   \\ 
{C_RED}/_-''    ''-_\\{C_RESET}
"""

def main():
    query = sys.argv[1].lower().strip() if len(sys.argv) > 1 else ""

    print(ARCH_LOGO)
    
    if query:
        print(f"  {C_DIM}Filtering commands matching: '{query}'{C_RESET}\n")

    matched_total = 0

    for sec in SECTIONS:
        filtered_items = []
        for cmd, desc in sec["items"]:
            if not query or query in cmd.lower() or query in desc.lower() or query in sec["title"].lower():
                filtered_items.append((cmd, desc))

        if not filtered_items:
            continue

        matched_total += len(filtered_items)
        print(f" {C_BOLD}{sec['color']} ┌─ {sec['title']}{C_RESET}")
        
        for i, (cmd, desc) in enumerate(filtered_items):
            is_last = (i == len(filtered_items) - 1)
            branch = "└─" if is_last else "├─"
            
            dots = 14 - len(cmd)
            dots_str = f"{C_GRAY}{'·' * max(2, dots)}{C_RESET}"
            print(f" {C_BOLD}{sec['color']} {branch}  {C_BOLD}{C_RED}{cmd:<14}{C_RESET} {dots_str} {C_WHITE}{desc}{C_RESET}")
            
        print() # Spacer

    if matched_total == 0:
        print(f"\n  {C_RED}No commands found matching '{query}'.{C_RESET}")
        print(f"  {C_DIM}Type 'cmds' to see the full list.{C_RESET}")

    print(f"  {C_DIM}Tip: Type 'cmds <keyword>' to filter (e.g. 'cmds git', 'cmds hypr', 'cmds vim'){C_RESET}\n")

if __name__ == "__main__":
    main()
