#!/usr/bin/env python3
"""
cmds: Fast, color-coded cheatsheet for all custom tools, aliases, and shortcuts.
Usage:
    cmds          (Show all commands)
    cmds <query>  (Filter commands matching query)
"""

import sys

C_RESET  = "\033[0m"
C_BOLD   = "\033[1m"
C_DIM    = "\033[2m"
C_CYAN   = "\033[38;2;137;180;250m"
C_GREEN  = "\033[38;2;166;227;161m"
C_YELLOW = "\033[38;2;249;226;175m"
C_RED    = "\033[38;2;243;139;168m"
C_PURPLE = "\033[38;2;203;166;247m"
C_ORANGE = "\033[38;2;250;179;135m"
C_GRAY   = "\033[38;2;108;112;134m"
C_ARCH   = "\033[38;2;23;147;209m"

SECTIONS = [
    {
        "title": "BASH & TERMINAL NAVIGATION (No Mouse)",
        "color": C_GREEN,
        "items": [
            ("z <dir>", "Zoxide: Instant smart jump to any directory (e.g. 'z hona')"),
            ("p", "Project Jump: Interactive fuzzy finder for ~/Personal and ~/Projects"),
            ("Ctrl + R", "FZF History: Search and execute past commands interactively"),
            ("Ctrl + T", "FZF Files: Search files in current folder interactively"),
            ("v [file]", "Fuzzy Edit: Search & open file directly in Neovim (fzf + bat)"),
            ("vc [file]", "Fuzzy Code: Search & open file directly in Antigravity IDE"),
            ("rgf [query]", "Find in Code: Search text with ripgrep & open at exact line"),
            ("fkill", "Kill Process: Interactive fuzzy process killer (multi-select Tab)"),
            ("mkcd <dir>", "Make & Enter: Create folder and cd into it in one step"),
            ("extract <file>", "Smart Extract: Unpack any archive (.tar.gz, .zip, .7z) cleanly"),
            ("clip / paste", "Wayland Clipboard: Pipe terminal output to/from clipboard"),
        ]
    },
    {
        "title": "HYPRLAND DESKTOP (No Mouse)",
        "color": C_PURPLE,
        "items": [
            ("Super + H", "Quick Cheatsheet Floating Popup (press any key to dismiss)"),
            ("Super + Q", "Open Terminal (Kitty)"),
            ("Super + R", "App Launcher (Rofi/Wofi)"),
            ("Super + E", "Open File Manager"),
            ("Super + V", "Clipboard History Menu (wl-clip-persist active)"),
            ("Super + C", "Close current active window"),
            ("Super + Space", "Toggle Floating Window"),
            ("Super + F", "Toggle Fullscreen Window"),
            ("Super + Tab", "Cycle forward between open windows"),
            ("Super + Arrows", "Move focus to window (Left/Right/Up/Down)"),
            ("Super + Shift + Arr", "Move window position (Left/Right/Up/Down)"),
            ("Super + Alt + Arr", "Smoothly resize active window width and height"),
            ("Super + 1..9", "Switch to workspace 1-9"),
            ("Super + Shift + 1..9", "Move active window to workspace 1-9"),
            ("Super + º (grave)", "Toggle 'Magic' Scratchpad Workspace (hidden desktop)"),
            ("Super + Shift + º", "Send window to 'Magic' Scratchpad"),
            ("Super + B", "Open Btop Live Resource Monitor (floating)"),
            ("Print / F11", "Area screenshot (automatically saved & copied to clipboard)"),
            ("Super + F10", "Toggle Warm Night Light (Hyprsunset)"),
        ]
    },
    {
        "title": "CHROMIUM & VIMIUM (No Mouse)",
        "color": C_CYAN,
        "items": [
            ("f", "Vimium: Show keyboard hints on all links/buttons (type to click)"),
            ("j / k", "Vimium: Scroll down / up smoothly"),
            ("J / K", "Vimium: Switch to left / right tab"),
            ("o", "Vimium: Open omnibar to search history and bookmarks"),
            ("x / X", "Vimium: Close current tab / Reopen last closed tab"),
            ("H / L", "Vimium: Go Back / Forward in browsing history"),
            ("Ctrl + L", "Focus URL Address bar (instantly ready to type)"),
            ("Ctrl + T / Ctrl + W", "Open new tab / Close current active tab"),
            ("Ctrl + Shift + T", "Reopen last closed tab (undo tab close)"),
            ("Ctrl + Tab", "Switch to next tab in Chromium"),
        ]
    },
    {
        "title": "FULLSTACK DEVELOPER TOOLS",
        "color": C_YELLOW,
        "items": [
            ("top / htop", "Process Monitor: Interactive dashboard for CPU, RAM & IO (btop)"),
            ("loc [port]", "Open Localhost: Instant open http://localhost:<port> in Chromium"),
            ("web <query|url>", "Web Search: Open URL or Google query in Chromium from CLI"),
            ("ports", "Ports: View active listening TCP ports, PIDs & commands ('ports 3000')"),
            ("killport", "Killport: Free blocked ports cleanly ('killport 3000', 'killport -f 8080')"),
            ("dev-db", "Dev-DB: Instant Docker databases ('dev-db up postgres|redis|mongo')"),
            ("ld", "Lazydocker: Real-time container dashboard, logs & restart controls"),
            ("d", "Dust: Visual disk analyzer (find & kill bloated node_modules)"),
            ("gh", "GitHub CLI: Manage PRs, issues, clones (e.g. 'gh pr create')"),
            ("bun / pnpm", "Fastest JS runtime & Disk-saving Node package manager"),
            ("uv", "Rust-powered Python package manager ('uv pip install ...')"),
            ("http", "HTTPie: Colorized human-friendly API testing ('http :3000/api')"),
        ]
    },
    {
        "title": "SYSTEM & LAPTOP DIAGNOSTICS",
        "color": C_ORANGE,
        "items": [
            ("lr", "Laptop Report: Live battery health, wattage, thermals & stats"),
            ("sudo powertop", "PowerTop: Process-by-process battery drain in Watts"),
            ("sudo intel_gpu_top", "Intel Arc GPU load, render engines & wattage"),
            ("sudo ufw status", "Check active firewall status & blocked connections"),
            ("sudo timeshift --c", "Create an immediate safety system restore point"),
            ("sysctl restart pipe", "Restart audio engine (systemctl --user restart pipewire)"),
        ]
    }
]

ARCH_LOGO = f"""
{C_ARCH}      /\\      {C_BOLD}{C_CYAN}╭──────────────────────────────────────────╮
{C_ARCH}     /  \\     {C_BOLD}{C_CYAN}│  {C_BOLD}ARCH LINUX - TERMINAL CHEATSHEET{C_CYAN}        │
{C_ARCH}    /    \\    {C_BOLD}{C_CYAN}│  {C_RESET}{C_DIM}Master your keyboard-driven workflow.{C_BOLD}{C_CYAN}   │
{C_ARCH}   /      \\   {C_BOLD}{C_CYAN}╰──────────────────────────────────────────╯
{C_ARCH}  /   ,,   \\  
{C_ARCH} /   |  |   \\ 
{C_ARCH}/_-''    ''-_\\{C_RESET}
"""

def main():
    query = sys.argv[1].lower().strip() if len(sys.argv) > 1 else ""

    print(ARCH_LOGO)
    
    if query:
        print(f"  {C_DIM}Filtering commands matching: '{query}'{C_RESET}\n")

    matched_total = 0

    for sec in SECTIONS:
        filtered_items = []
        for cmd, desc in sec["items"]:
            if not query or query in cmd.lower() or query in desc.lower() or query in sec["title"].lower():
                filtered_items.append((cmd, desc))

        if not filtered_items:
            continue

        matched_total += len(filtered_items)
        print(f" {C_BOLD}{sec['color']} ┌─ {sec['title']}{C_RESET}")
        
        for i, (cmd, desc) in enumerate(filtered_items):
            is_last = (i == len(filtered_items) - 1)
            branch = "└─" if is_last else "├─"
            
            dots = 22 - len(cmd)
            dots_str = f"{C_GRAY}{'·' * max(2, dots)}{C_RESET}"
            print(f" {C_BOLD}{sec['color']} │  {C_BOLD}{C_CYAN}{cmd:<18}{C_RESET} {dots_str} {desc}")
            
        print() # Spacer

    if matched_total == 0:
        print(f"\n  {C_RED}No commands found matching '{query}'.{C_RESET}")
        print(f"  {C_DIM}Type 'cmds' to see the full list.{C_RESET}")

    print(f"  {C_DIM}Tip: Type 'cmds <keyword>' to filter (e.g. 'cmds git', 'cmds hypr', 'cmds vim'){C_RESET}\n")

if __name__ == "__main__":
    main()
