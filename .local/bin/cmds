def normalize(text):
    return ''.join(c for c in unicodedata.normalize('NFKD', text.lower()) if not unicodedata.combining(c))


def styled_runs(line, base_style):
    parts = line.split('`')
    for index, part in enumerate(parts):
        if not part:
            continue
        yield part, (base_style if index % 2 == 0 else 4)


def render(width, query=''):
    rows = []
    w = max(40, width)
    
    # Sleek Apple Obsidian / Arch Linux Header Banner
    rows.append(('╭' + '─' * (w - 2) + '╮', 2))
    title_text = "  󰌌  HYPRLAND & ARCH LINUX COMMAND PALETTE"
    badge_text = "[Super+H Reference]  "
    space_len = max(1, w - 2 - len(title_text) - len(badge_text))
    header_line = "│" + title_text + " " * space_len + badge_text + "│"
    rows.append((header_line, 1))
    rows.append(('╰' + '─' * (w - 2) + '╯', 2))
    rows.append(('', 0))

    needle = normalize(query)
    total = 0
    matched_sections = 0

    for index, (title, items) in enumerate(SECTIONS, 1):
        matched = [(cmd, desc) for cmd, desc in items
                   if needle in normalize(f'{title} {cmd} {desc}')]
        if not matched:
            continue
        matched_sections += 1
        
        # Section Header Banner
        clean_title = f"{title}"
        rows.append((f"  {clean_title}", 1))
        rows.append(('  ' + '┄' * (w - 4), 2))
        
        for cmd, desc in matched:
            total += 1
            cmd_badge = f"{cmd}"
            if w >= 90:
                left_col_width = 38
                desc_width = w - left_col_width - 6
                parts = textwrap.wrap(desc, desc_width)
                rows.append((f"    `{cmd_badge:<{left_col_width}}`  {parts[0]}", 0))
                for part in parts[1:]:
                    rows.append((' ' * (left_col_width + 8) + part, 0))
            else:
                rows.append((f"    `{cmd_badge}`", 3))
                for desc_line in textwrap.wrap(desc, w - 8):
                    rows.append((f"      {desc_line}", 0))
        rows.append(('', 0))

    if total == 0:
        rows.append((f"  󰅖  No commands matching '{query}' found.", 2))
        rows.append(('', 0))

    return rows


def popup(screen, initial_query=''):
    curses.curs_set(0)
    styles = [0, curses.A_BOLD, curses.A_DIM, curses.A_BOLD, curses.A_BOLD]
    
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        
        if curses.COLORS >= 256:
            # High-end 256-color palette
            curses.init_pair(1, 114, -1)  # Emerald/Lime title (#6fbf27)
            curses.init_pair(2, 242, -1)  # Zinc borders (#6c7086)
            curses.init_pair(3, 38, -1)   # Vibrant sky cyan (#38bdf8)
            curses.init_pair(4, 38, -1)   # Command highlights
            curses.init_pair(5, 220, -1)  # Amber gold
        else:
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_CYAN, -1)
            curses.init_pair(3, curses.COLOR_CYAN, -1)
            curses.init_pair(4, curses.COLOR_CYAN, -1)
            curses.init_pair(5, curses.COLOR_YELLOW, -1)

        styles[1] = curses.color_pair(1) | curses.A_BOLD
        styles[2] = curses.color_pair(2)
        styles[3] = curses.color_pair(3) | curses.A_BOLD
        styles[4] = curses.color_pair(4) | curses.A_BOLD

    query, offset, editing = initial_query, 0, False

    while True:
        height, width = screen.getmaxyx()
        content = render(max(30, width - 2), query)
        page = max(1, height - 4)
        offset = min(max(0, offset), max(0, len(content) - page))
        screen.erase()

        def put(y, value, style=0):
            if 0 <= y < height:
                try:
                    screen.addnstr(y, 0, value, max(0, width - 1), style)
                except curses.error:
                    pass

        # Draw content lines
        for y, (line, style) in enumerate(content[offset:offset + page]):
            x = 0
            for text, color in styled_runs(line, style):
                if x >= width - 1:
                    break
                try:
                    screen.addnstr(y, x, text, width - 1 - x, styles[color])
                except curses.error:
                    pass
                x += len(text)

        # Draw bottom status & navigation bar
        put(height - 3, '─' * max(0, width - 1), styles[2])
        nav_info = "  ↑↓/jk Scroll  •  PgUp/PgDn Page  •  g/G Top/End  •  / Search  •  q Quit"
        put(height - 2, nav_info, styles[1])

        if editing:
            status = f"  󰍉 Search query: {query}▏  (Enter: finish, Esc: cancel)"
            put(height - 1, status, styles[3])
        else:
            filter_label = query if query else "All Commands"
            pos_info = f"{offset + 1}–{min(offset + page, len(content))} of {len(content)} lines"
            status = f"  󰍉 Filter: [{filter_label}]  •  {pos_info}  •  Press / to search"
            put(height - 1, status, styles[2])

        screen.refresh()
        key = screen.get_wch()

        if editing:
            if key in ('\n', '\r'):
                editing = False
            elif key == '\x1b':
                query, editing = '', False
            elif key in (curses.KEY_BACKSPACE, '\x7f', '\b'):
                query = query[:-1]
            elif isinstance(key, str) and key.isprintable():
                query += key
            offset = 0
        elif key in ('q', 'Q'):
            return
        elif key == '/':
            query, editing, offset = '', True, 0
        elif key == '\x1b':
            query, offset = '', 0
        elif key in (curses.KEY_DOWN, 'j'):
            offset += 1
        elif key in (curses.KEY_UP, 'k'):
            offset -= 1
        elif key in (curses.KEY_NPAGE, ' '):
            offset += page
        elif key == curses.KEY_PPAGE:
            offset -= page
        elif key in (curses.KEY_HOME, 'g'):
            offset = 0
        elif key in (curses.KEY_END, 'G'):
            offset = len(content)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--popup', action='store_true', help='Browsable guide with search')
    parser.add_argument('query', nargs='*', help='Filter commands and sections')
    args = parser.parse_args()
    query = ' '.join(args.query)

    if args.popup and sys.stdin.isatty() and sys.stdout.isatty():
        curses.wrapper(popup, query)
    else:
        # High quality ANSI colors for standard terminal print
        colors = [
            '\033[0m',                          # 0 default
            '\033[1;38;2;160;219;106m',        # 1 emerald bold
            '\033[38;2;113;113;122m',          # 2 zinc muted
            '\033[1;38;2;56;189;248m',         # 3 sky cyan bold
            '\033[1;38;2;56;189;248m',         # 4 highlight bold
            '\033[38;2;255;214;10m'            # 5 amber
        ]
        term_width = shutil.get_terminal_size((100, 30)).columns - 2
        for line, style in render(term_width, query):
            if sys.stdout.isatty():
                print(''.join(f'{colors[color]}{text}\033[0m' for text, color in styled_runs(line, style)))
            else:
                print(line)
        if sys.stdout.isatty():
            print('\033[38;2;113;113;122m  Filter: cmds <query>  •  Interactive palette: Super + H  or  cmds --popup\033[0m\n')


if __name__ == '__main__':
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
