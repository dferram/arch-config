# Native terminal pixel art: no image protocol or extra dependency required.
# Compact charcoal keycap, with a flat face and beveled pixel edges.
LOGO = [
    '   ▄▄▄▄▄▄▄▄▄▄▄▄       ',
    ' ▄█▀          ▀█▄     ',
    ' ██            ██     ',
    ' ██    Ctrl    ██  +  ',
    ' ██            ██     ',
    ' ▀█▄▄▄▄▄▄▄▄▄▄▄▄█▀     ',
    '   ▀▀▀▀▀▀▀▀▀▀▀▀       ',
]


def styled_runs(line, style):
    """Share the keycap palette between curses and ordinary terminal output."""
    if style < 10:
        return [(line, style)]
    row = style - 10
    runs = []
    for x, char in enumerate(line):
        if x >= len(LOGO[row]):
            color = 1
        elif 1 <= row <= 5 and 3 <= x < 15:
            color = 5 if char in ' Ctrl' else 6
        elif char in '▄▀█':
            color = 4
        else:
            color = 0
        if runs and runs[-1][1] == color:
            runs[-1] = (runs[-1][0] + char, color)
        else:
            runs.append((char, color))
    return runs


def normalize(value):
    return ''.join(c for c in unicodedata.normalize('NFD', value.casefold())
                   if not unicodedata.combining(c))


def render(width, query=''):
    """Return (text, style) rows, wrapped before applying terminal colors."""
    width = max(20, width)
    rows = []
    titles = ['', 'FERRAM / COMMAND CENTER', 'SHORTCUTS & COMMANDS', '',
              'Super = Windows key', 'Shortcuts grouped by application', '']
    logo_width = max(map(len, LOGO))
    side_by_side = width >= logo_width + 2 + max(map(len, titles))
    for index, pixel in enumerate(LOGO):
        title = titles[index] if index < len(titles) else ''
        line = pixel.ljust(logo_width) + '  ' + title if side_by_side else pixel
        rows.append((line[:width].rstrip(), 10 + index))
    if not side_by_side:
        rows.append(('SHORTCUTS & COMMANDS', 1))
    rows.append(('', 0))
    needle = normalize(query)
    total = 0
    for index, (title, items) in enumerate(SECTIONS, 1):
        matched = [(cmd, desc) for cmd, desc in items
                   if needle in normalize(f'{title} {cmd} {desc}')]
        if not matched:
            continue
        for line in textwrap.wrap(f'{index:02d} / {title}', width):
            rows.append((line, 1))
        rows.append(('─' * width, 2))
        for cmd, desc in matched:
            total += 1
            if width >= 90:
                parts = textwrap.wrap(desc, width - 38)
                rows.append((f'  {cmd:<34}  {parts[0]}', 0))
                rows.extend((' ' * 38 + part, 0) for part in parts[1:])
            else:
                rows.extend((line, 3) for line in textwrap.wrap(cmd, width, initial_indent='  ', subsequent_indent='  '))
                rows.extend((line, 0) for line in textwrap.wrap(desc, width, initial_indent='    ', subsequent_indent='    '))
        rows.append(('', 0))
    rows.append((f'{total} entries' if total else 'No matches found.', 2))
    return rows


def popup(screen, initial_query=''):
    curses.curs_set(0)
    styles = [0, curses.A_BOLD, curses.A_DIM, curses.A_BOLD, 0, curses.A_BOLD, 0]
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        styles[1] |= curses.color_pair(1)
        styles[3] |= curses.color_pair(1)
        # xterm's neutral grays keep the key distinct from the cyan guide.
        edge, face = (238, 242) if curses.COLORS >= 256 else (curses.COLOR_BLACK, curses.COLOR_BLACK)
        curses.init_pair(2, edge, -1)
        curses.init_pair(3, curses.COLOR_WHITE, face)
        curses.init_pair(4, edge, face)
        styles[4] = curses.color_pair(2)
        styles[5] |= curses.color_pair(3)
        styles[6] = curses.color_pair(4)
    query, offset, editing = initial_query, 0, False
    while True:
        height, width = screen.getmaxyx()
        content = render(max(20, width - 2), query)
        page = max(1, height - 3)
        offset = min(max(0, offset), max(0, len(content) - page))
        screen.erase()
        def put(y, value, style=0):
            if 0 <= y < height:
                try:
                    screen.addnstr(y, 0, value, max(0, width - 1), style)
                except curses.error:
                    pass  # Tiny terminal or bottom-right cell during resize.
        for y, (line, style) in enumerate(content[offset:offset + page]):
            x = 0
            for text, color in styled_runs(line, style):
                if x >= width - 1:
                    break
                try:
                    screen.addnstr(y, x, text, width - 1 - x, styles[color])
                except curses.error:
                    pass
                x += len(text)
        put(height - 3, '─' * max(0, width - 1), styles[2])
        put(height - 2, '↑↓ / j k scroll · PgUp/PgDn page · g/G top/end · / search · q quit', styles[1])
        status = f'Search: {query}▏' if editing else f'Filter: {query or "all"} · {offset + 1}–{min(offset + page, len(content))}/{len(content)} · Esc clear'
        put(height - 1, status, styles[2])
        screen.refresh()
        key = screen.get_wch()
        if editing:
            if key in ('\n', '\r'):
                editing = False
            elif key == '\x1b':
                query, editing = '', False
            elif key in (curses.KEY_BACKSPACE, '\x7f', '\b'):
                query = query[:-1]
            elif isinstance(key, str) and key.isprintable():
                query += key
            offset = 0
        elif key in ('q', 'Q'):
            return
        elif key == '/':
            query, editing, offset = '', True, 0
        elif key == '\x1b':
            query, offset = '', 0
        elif key in (curses.KEY_DOWN, 'j'):
            offset += 1
        elif key in (curses.KEY_UP, 'k'):
            offset -= 1
        elif key in (curses.KEY_NPAGE, ' '):
            offset += page
        elif key == curses.KEY_PPAGE:
            offset -= page
        elif key in (curses.KEY_HOME, 'g'):
            offset = 0
        elif key in (curses.KEY_END, 'G'):
            offset = len(content)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--popup', action='store_true', help='Browsable guide with search')
    parser.add_argument('query', nargs='*', help='Filter commands and sections')
    args = parser.parse_args()
    query = ' '.join(args.query)
    if args.popup and sys.stdin.isatty() and sys.stdout.isatty():
        curses.wrapper(popup, query)
    else:
        colors = ['', '\033[1;38;2;127;196;219m', '\033[2m', '\033[38;2;66;160;191m',
                  '\033[38;5;238m', '\033[1;37;48;5;242m', '\033[38;5;238;48;5;242m']
        for line, style in render(shutil.get_terminal_size((100, 30)).columns - 2, query):
            print(''.join(f'{colors[color]}{text}\033[0m' for text, color in styled_runs(line, style))
                  if sys.stdout.isatty() else line)
        print('\nFilter: cmds <text> · Interactive guide: cmds --popup')


if __name__ == '__main__':
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
