#!/usr/bin/env python3
"""
hypr-mic:
Microphone mute toggle with synchronized OSD feedback.
"""
import subprocess
import sys

def get_mute_status():
    try:
        out = subprocess.check_output(["pactl", "get-source-mute", "@DEFAULT_SOURCE@"], stderr=subprocess.DEVNULL).decode()
        return "yes" in out.lower()
    except Exception:
        return False

def notify_mic(is_muted):
    icon = "microphone-sensitivity-muted-symbolic" if is_muted else "microphone-sensitivity-high-symbolic"
    title = "Microphone Muted" if is_muted else "Microphone Active"
    try:
        subprocess.run([
            "notify-send", "-a", "Microphone",
            "-i", icon,
            "-t", "1200",
            "-h", "string:x-canonical-private-synchronous:microphone",
            "-h", "string:synchronous:microphone",
            "-h", f"boolean:muted:{'true' if is_muted else 'false'}",
            title
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    action = sys.argv[1].lower().strip() if len(sys.argv) > 1 else "toggle"
    if action in ["toggle", "mute", "t"]:
        subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif action == "on":
        subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif action == "off":
        subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    is_muted = get_mute_status()
    notify_mic(is_muted)
    print("MUTED" if is_muted else "ACTIVE")

if __name__ == "__main__":
    main()
